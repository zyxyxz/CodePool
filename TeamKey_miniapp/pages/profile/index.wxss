.page {
  padding: 16px;
}

.profile {
  text-align: center;
}

.avatar {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  margin-bottom: 12px;
}

.name {
  display: block;
  font-size: 18px;
  font-weight: 600;
}

.openid {
  display: block;
  margin: 8px 0;
  font-size: 12px;
  color: #6b7280;
}

.team-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #e5e7eb;
}

.team-row:last-child {
  border-bottom: none;
}

.danger {
  text-align: center;
}

.danger-btn {
  border-color: #f43f5e;
  color: #f43f5e;
}

.login-card {
  text-align: center;
  margin-top: 24px;
}

.login-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 8px;
}

.login-desc {
  color: #6b7280;
  margin-bottom: 16px;
}

.profile-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.profile-preview .avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #f1f5f9;
}

.profile-preview .nickname {
  font-size: 16px;
  font-weight: 600;
  color: #1f2933;
}

.profile-actions {
  margin-top: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
