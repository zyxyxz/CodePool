<view class="page">
  <block wx:if="{{loading}}">
    <view class="card">领取中...</view>
  </block>
  <block wx:elif="{{error}}">
    <view class="card error">{{error}}</view>
  </block>
  <block wx:else>
    <view class="card">
      <view class="title">TeamKey 分享</view>
      <view class="code">{{payload.code || payload.secret}}</view>
      <view class="meta">位数：{{payload.digits || '--'}} 周期：{{payload.period || '--'}}s</view>
      <button class="button-primary" bindtap="handleCopy">复制</button>
    </view>
  </block>
</view>
