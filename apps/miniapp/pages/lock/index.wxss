.lock-page{padding-top:80rpx}.lock-symbol{display:block;width:88rpx;height:88rpx;line-height:88rpx;text-align:center;border-radius:28rpx;background:var(--cp-tint);color:var(--cp-accent);margin:0 auto 24rpx}.lock-brand,.lock-title,.lock-desc,.lock-note{display:block;text-align:center}.lock-brand{font-family:Georgia,serif;font-size:34rpx;color:var(--cp-accent)}.lock-title{font-size:40rpx;font-weight:600;margin:28rpx 0 16rpx}.lock-desc,.lock-note{font-size:24rpx;line-height:1.8;color:var(--cp-muted);margin-bottom:36rpx}.pin-label{display:block;font-size:25rpx;margin:24rpx 0 16rpx}.pin{letter-spacing:12rpx}.submit{margin-top:32rpx}.lock-error{display:block;color:#B42318;font-size:25rpx;line-height:1.6;margin-top:20rpx}.lock-note{margin:28rpx 0 16rpx}.biometric{margin-bottom:24rpx}
.bio-intro{display:block;text-align:center;color:var(--cp-muted);font-size:25rpx;line-height:1.7;margin-bottom:28rpx}
