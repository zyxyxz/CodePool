.about-header { padding: 38rpx 20rpx 30rpx; display: flex; align-items: center; flex-direction: column; }
.brand-mark { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--cp-border); border-radius: 30rpx; background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-accent); font-size: 36rpx; font-weight: 650; box-shadow: 0 10rpx 28rpx rgba(62, 52, 42, .06); }
.app-name { margin-top: 18rpx; color: var(--cp-ink); font-size: 36rpx; font-weight: 650; }
.app-desc,.app-version { margin-top: 8rpx; color: var(--cp-muted); font-size: 23rpx; }
.app-version { margin-top: 16rpx; padding: 7rpx 18rpx; border-radius: 999rpx; border: 1rpx solid var(--cp-border); background: var(--cp-surface); font-size: 20rpx; }
.section-label { margin: 28rpx 8rpx 14rpx; color: var(--cp-muted); font-size: 23rpx; font-weight: 650; }
.menu-card { padding-top: 0; padding-bottom: 0; }
.menu-row { min-height: 108rpx; padding: 12rpx 0; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--cp-border); }
.menu-row:last-child { border-bottom: 0; }
.menu-row:active { opacity: .65; }
.menu-row > view { min-width: 0; }
.menu-title,.menu-desc { display: block; }
.menu-title { color: var(--cp-ink); font-size: 27rpx; font-weight: 630; }
.menu-desc { margin-top: 6rpx; color: var(--cp-muted); font-size: 21rpx; line-height: 1.5; word-break: break-all; }
.arrow { flex: none; color: var(--cp-muted); font-size: 36rpx; }
.logout-button { width: 100%; margin-top: 26rpx; }
