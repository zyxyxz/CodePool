<view wx:if="{{!vaultLocked}}">
<view class="page settings-page" style="{{themeStyle}}">
  <view class="about-header">
    <view class="brand-mark">CP</view>
    <text class="app-name">CodePool</text>
    <text class="app-desc">让团队的代码与密钥有序协作</text>
    <text class="app-version">版本 {{version}}</text>
  </view>

  <view class="section-label">关于与隐私</view>
  <view class="card menu-card" wx:if="{{!needsLogin}}">
    <view class="menu-row" bindtap="handleLockNow"><text class="menu-title">立即锁定密钥钱包</text><text class="arrow">›</text></view>
    <view class="menu-row" bindtap="handleChangePin"><text class="menu-title">修改安全 PIN</text><text class="arrow">›</text></view>
  </view>
  <view class="card menu-card">
    <view class="menu-row" bindtap="goPrivacy"><text class="menu-title">隐私政策</text><text class="arrow">›</text></view>
    <view class="menu-row" bindtap="goTerms"><text class="menu-title">用户协议</text><text class="arrow">›</text></view>
    <view class="menu-row" bindtap="handleClearCache"><view><text class="menu-title">清理本地缓存</text><text class="menu-desc">清理草稿，保留团队数据</text></view><text class="arrow">›</text></view>
  </view>

  <view class="section-label">账号管理</view>
  <view class="card state-card" wx:if="{{loading}}"><text class="state-title">正在读取账号状态</text></view>
  <view class="card menu-card" wx:elif="{{needsLogin}}">
    <view class="menu-row" bindtap="goProfile"><view><text class="menu-title">登录 CodePool</text><text class="menu-desc">登录后管理账号与团队</text></view><text class="arrow">›</text></view>
  </view>
  <block wx:else>
    <view class="card menu-card">
      <view class="menu-row" bindtap="handleCancellation">
        <view><text class="menu-title">{{canWithdrawDeletion ? '账号注销申请' : '账号注销'}}</text><text class="menu-desc">{{deletionLoading ? '正在读取状态…' : deletionError ? '状态读取失败，点击重试' : deletionRequest ? deletionStatusLabel + ' · ' + deletionRequestedText : '了解注销流程或提交申请'}}</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="menu-row" bindtap="handleClearLocalLogin"><view><text class="menu-title">清除本地登录</text><text class="menu-desc">退出本机并清理未保存草稿</text></view><text class="arrow">›</text></view>
    </view>
    <button class="button-ghost logout-button" bindtap="handleLogout">退出登录</button>
  </block>
</view>
</view>
<view wx:else class="vault-curtain">CodePool · 已锁定</view>
