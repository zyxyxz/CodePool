.offline-bar {
  margin: -28rpx -28rpx 20rpx;
  padding: 16rpx;
  background: #fff4dc;
  color: #7a4d00;
  text-align: center;
  font-size: 23rpx;
}

.login-card {
  margin-top: 8vh;
  padding: 48rpx 36rpx;
  text-align: center;
}

.login-title,
.login-desc {
  display: block;
}

.login-title {
  font-size: 38rpx;
  font-weight: 730;
}

.login-desc {
  margin: 14rpx auto 28rpx;
  color: #718078;
  font-size: 24rpx;
  line-height: 1.6;
}

.avatar-picker {
  width: 190rpx;
  margin: 0 auto 20rpx;
}

.avatar-button {
  width: 180rpx;
  margin: 0 auto;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: transparent;
  color: #718078;
  font-size: 22rpx;
}

.avatar-alternate {
  width: 100%;
  min-height: 46rpx;
  margin-top: 4rpx;
  padding: 4rpx;
  background: transparent;
  color: #15803d;
  font-size: 19rpx;
}

.login-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
}

.nickname-input {
  margin-bottom: 18rpx;
  text-align: center;
}

.consent-row { margin: 18rpx 0; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6rpx; color: #66736b; font-size: 22rpx; }
.consent-row label { display: flex; align-items: center; }
.consent-row checkbox { transform: scale(.72); }
.legal-link { color: #15803d; }

.team-header {
  padding: 10rpx 6rpx 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow,
.page-title,
.page-desc,
.workspace-name,
.workspace-meta,
.invite-title,
.invite-desc,
.member-name,
.member-meta,
.member-expiry,
.invite-role,
.invite-time {
  display: block;
}

.eyebrow {
  color: #15803d;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 0;
}

.page-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 750;
}

.page-desc {
  margin-top: 8rpx;
  color: #718078;
  font-size: 23rpx;
}

.create-button {
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  background: #17231d;
  color: #ffffff;
  font-size: 23rpx;
}

.accept-empty {
  margin-top: 12rpx;
}

.workspace-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #101820;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 32, 0.13);
}

.workspace-picker {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workspace-picker > text {
  color: #7ce79d;
  font-size: 23rpx;
}

.workspace-name {
  font-size: 34rpx;
  font-weight: 700;
}

.workspace-meta {
  margin-top: 8rpx;
  color: #9eaaa3;
  font-size: 21rpx;
}

.workspace-actions {
  padding: 24rpx 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.invite-ready {
  margin-top: 22rpx;
  border-color: #b7ddc1;
  background: #f0f9f2;
}

.invite-title {
  font-size: 29rpx;
  font-weight: 680;
}

.invite-desc {
  margin-top: 8rpx;
  color: #5f6f65;
  font-size: 22rpx;
}

.invite-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.section-head {
  margin: 34rpx 8rpx 16rpx;
  display: flex;
  justify-content: space-between;
  color: #5c6b62;
  font-size: 24rpx;
  font-weight: 650;
}

.member-list,
.invite-list {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.member-row,
.invite-row {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.member-row:last-child,
.invite-row:last-child {
  border-bottom: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 50%;
  background: #edf2ef;
}

.member-info {
  min-width: 0;
  flex: 1;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.self {
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #edf7f0;
  color: #166534;
  font-size: 18rpx;
}

.member-meta,
.member-expiry {
  margin-top: 6rpx;
  color: #718078;
  font-size: 21rpx;
}

.member-expiry {
  color: #8a650d;
}

.manage-button {
  min-height: 68rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #edf7f0;
  color: #166534;
  font-size: 22rpx;
}

.locked {
  color: #89958e;
  font-size: 21rpx;
}

.invite-row {
  justify-content: space-between;
}

.invite-role {
  font-size: 26rpx;
  font-weight: 650;
}

.invite-time {
  margin-top: 6rpx;
  color: #89958e;
  font-size: 21rpx;
}

.invite-status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: #718078;
  font-size: 20rpx;
}

.invite-status.active {
  background: #edf7f0;
  color: #166534;
}

.empty-list {
  padding: 32rpx 0;
  color: #89958e;
  text-align: center;
  font-size: 24rpx;
}

.safe-note {
  margin-top: 22rpx;
}
