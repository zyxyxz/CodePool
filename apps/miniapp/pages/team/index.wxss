.offline-bar {
  margin: -28rpx -28rpx 20rpx;
  padding: 16rpx;
  background: #fff4dc;
  color: #7a4d00;
  text-align: center;
  font-size: 23rpx;
}

.login-card {
  margin-top: 8vh;
  padding: 48rpx 36rpx;
  text-align: center;
}

.login-title,
.login-desc {
  display: block;
}

.login-title {
  font-size: 38rpx;
  font-weight: 730;
}

.login-desc {
  margin: 14rpx auto 28rpx;
  color: #718078;
  font-size: 24rpx;
  line-height: 1.6;
}

.avatar-picker {
  width: 190rpx;
  margin: 0 auto 20rpx;
}

.avatar-button {
  width: 180rpx;
  margin: 0 auto;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: transparent;
  color: #718078;
  font-size: 22rpx;
}

.avatar-alternate {
  width: 100%;
  min-height: 46rpx;
  margin-top: 4rpx;
  padding: 4rpx;
  background: transparent;
  color: #15803d;
  font-size: 19rpx;
}

.login-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
}

.nickname-input {
  margin-bottom: 18rpx;
  text-align: center;
}

.consent-row { margin: 18rpx 0; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6rpx; color: #66736b; font-size: 22rpx; }
.consent-row label { display: flex; align-items: center; }
.consent-row checkbox { transform: scale(.72); }
.legal-link { color: #15803d; }

.team-header {
  padding: 10rpx 6rpx 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow,
.page-title,
.page-desc,
.workspace-name,
.workspace-meta,
.invite-title,
.invite-desc,
.member-name,
.member-meta,
.member-expiry,
.invite-role,
.invite-time {
  display: block;
}

.eyebrow {
  color: #15803d;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 0;
}

.page-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 750;
}

.page-desc {
  margin-top: 8rpx;
  color: #718078;
  font-size: 23rpx;
}

.create-button {
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  background: #17231d;
  color: #ffffff;
  font-size: 23rpx;
}

.accept-empty {
  margin-top: 12rpx;
}

.workspace-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #101820;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 32, 0.13);
}

.workspace-picker {
  padding: 12rpx 32rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workspace-picker > text {
  flex: none;
  margin-left: 18rpx;
  color: #ffffff;
  font-size: 23rpx;
}

.workspace-picker > view,
.sheet-heading > view {
  flex: 1;
  min-width: 0;
}

.workspace-name {
  font-size: 34rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.workspace-meta {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

.workspace-actions {
  padding: 24rpx 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.workspace-actions > button:only-child {
  grid-column: 1 / -1;
}

.workspace-card-top {
  padding: 20rpx 26rpx 0 32rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
}

.workspace-edit {
  min-height: 60rpx;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 22rpx;
}

.invite-ready {
  margin-top: 22rpx;
  border-color: #b7ddc1;
  background: #f0f9f2;
}

.invite-title {
  font-size: 29rpx;
  font-weight: 680;
  min-width: 0;
  overflow-wrap: anywhere;
}

.invite-desc {
  margin-top: 8rpx;
  color: #5f6f65;
  font-size: 22rpx;
}

.invite-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.invite-actions > button {
  flex: 1;
}

.invite-ready-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.invite-ready-head .invite-status {
  flex: none;
}

.invite-code-box {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #d7e8db;
  border-radius: 12rpx;
  background: #ffffff;
}

.invite-code-label,
.invite-code {
  display: block;
}

.invite-code-label {
  margin-bottom: 8rpx;
  color: #718078;
  font-size: 20rpx;
}

.invite-code {
  color: #20382a;
  font-family: Menlo, Consolas, monospace;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
}

.invite-inactive {
  background: #f5f7f6;
  border-color: #dfe6e1;
}

.invite-inactive .invite-code {
  color: #859089;
}

.team-data-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #fff4dc;
  color: #7a4d00;
  font-size: 22rpx;
}

.team-data-error button {
  flex: none;
  min-height: 56rpx;
  padding: 10rpx 16rpx;
  background: transparent;
  color: #7a4d00;
  font-size: 22rpx;
}

.section-head {
  margin: 34rpx 8rpx 16rpx;
  display: flex;
  justify-content: space-between;
  color: #5c6b62;
  font-size: 24rpx;
  font-weight: 650;
}

.member-list,
.invite-list {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.member-row,
.invite-row {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf1ee;
}

.member-row:last-child,
.invite-row:last-child {
  border-bottom: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 50%;
  background: #edf2ef;
}

.member-info {
  min-width: 0;
  flex: 1;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.self {
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: #edf7f0;
  color: #166534;
  font-size: 18rpx;
}

.member-meta,
.member-expiry {
  margin-top: 6rpx;
  color: #718078;
  font-size: 21rpx;
}

.member-expiry {
  color: #8a650d;
}

.manage-button {
  min-height: 68rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #edf7f0;
  color: #166534;
  font-size: 22rpx;
}

.locked {
  color: #89958e;
  font-size: 21rpx;
}

.invite-row {
  justify-content: space-between;
}

.invite-role {
  font-size: 26rpx;
  font-weight: 650;
}

.invite-time {
  margin-top: 6rpx;
  color: #89958e;
  font-size: 21rpx;
}

.invite-status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: #718078;
  font-size: 20rpx;
}

.invite-status.active {
  background: #edf7f0;
  color: #166534;
}

.empty-list {
  padding: 32rpx 0;
  color: #89958e;
  text-align: center;
  font-size: 24rpx;
}

.safe-note {
  margin-top: 22rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(10, 23, 15, 0.46);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx;
  background: #ffffff;
}

.sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sheet-title,
.sheet-desc,
.field-label,
.sheet-hint,
.sheet-error {
  display: block;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 730;
}

.sheet-desc {
  margin-top: 8rpx;
  color: #718078;
  font-size: 23rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.sheet-close {
  flex: none;
  width: 60rpx;
  min-height: 60rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #f0f4f1;
  color: #65756b;
  font-size: 36rpx;
}

.field-label {
  margin: 24rpx 0 14rpx;
  color: #34493c;
  font-size: 24rpx;
  font-weight: 650;
}

.theme-options {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6rpx;
}

.theme-option {
  min-width: 0;
  min-height: 112rpx;
  padding: 10rpx 2rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: transparent;
  color: #718078;
  font-size: 19rpx;
}

.theme-option.selected {
  border-color: #d7e1db;
  background: #f4f7f5;
  color: #17231d;
}

.theme-dot {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  font-size: 28rpx;
}

.theme-preview {
  padding: 24rpx;
  margin-top: 22rpx;
  border-radius: 14rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 20rpx;
}

.preview-name {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.role-options {
  display: grid;
  gap: 10rpx;
}

.role-option {
  padding: 18rpx 22rpx;
  justify-content: space-between;
  gap: 12rpx;
  border: 2rpx solid #e4ebe6;
  border-radius: 12rpx;
  background: #ffffff;
  text-align: left;
}

.role-option.selected {
  background: #f0f9f3;
  border-color: #7ebd92;
}

.role-option-title,
.role-option-desc {
  display: block;
}

.role-option-title {
  color: #20382a;
  font-size: 26rpx;
  font-weight: 650;
}

.role-option-desc {
  margin-top: 6rpx;
  color: #718078;
  font-size: 21rpx;
  font-weight: 400;
}

.option-check {
  flex: none;
  width: 34rpx;
  color: #15803d;
  font-size: 28rpx;
}

.duration-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.duration-option {
  min-height: 72rpx;
  padding: 12rpx 4rpx;
  border: 2rpx solid #e4ebe6;
  border-radius: 12rpx;
  background: #ffffff;
  color: #5f6f65;
  font-size: 23rpx;
}

.duration-option.selected {
  background: #f0f9f3;
  border-color: #7ebd92;
  color: #166534;
}

.sheet-hint {
  margin-top: 20rpx;
  color: #718078;
  font-size: 22rpx;
  line-height: 1.6;
}

.sheet-error {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
  background: #fff1ee;
  color: #b42318;
  font-size: 23rpx;
  line-height: 1.5;
}

.sheet-submit {
  width: 100%;
  margin-top: 28rpx;
}

.join-field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.join-field-label .field-label {
  margin: 0;
}

.paste-button {
  min-height: 68rpx;
  padding: 12rpx 0 12rpx 18rpx;
  color: #15803d;
  background: transparent;
  font-size: 23rpx;
}

.join-code-input {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
}
