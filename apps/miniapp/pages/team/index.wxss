.list-summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12rpx; margin: 8rpx 0 24rpx; color: var(--cp-muted); font-size: 23rpx; }
.team-card { display: block; width: 100%; margin: 0 0 24rpx; padding: 30rpx; text-align: left; line-height: 1.5; border: 1rpx solid var(--cp-border); border-radius: 28rpx; background: linear-gradient(120deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-ink); }
.team-card::after, .add-team-card::after { border: 0; }
.team-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.team-role { color: var(--cp-accent); font-size: 23rpx; }
.current-badge { padding: 5rpx 14rpx; border-radius: 20rpx; background: var(--cp-surface); color: var(--cp-accent); font-size: 21rpx; }
.team-card-main { display: flex; align-items: center; gap: 20rpx; margin: 20rpx 0 12rpx; }
.team-card-name { flex: 1; min-width: 0; overflow-wrap: break-word; font-size: 36rpx; font-weight: 600; }
.team-card-arrow { flex: none; color: var(--cp-accent); font-size: 44rpx; }
.team-card-meta { color: var(--cp-muted); font-size: 24rpx; }
.add-team-card { display: flex; flex-direction: column; align-items: center; width: 100%; padding: 28rpx 20rpx 36rpx; margin-top: 8rpx; border: 2rpx dashed var(--cp-accent); border-radius: 28rpx; background: transparent; line-height: 1.6; color: var(--cp-accent); }
.add-team-plus { font-size: 48rpx; font-weight: 300; }
.add-team-title { font-size: 29rpx; font-weight: 600; }
.add-team-desc { margin-top: 8rpx; color: var(--cp-muted); font-size: 23rpx; white-space: normal; }

.offline-bar {
  margin: -32rpx -32rpx 24rpx;
  padding: 16rpx;
  background: #fff4dc;
  color: #7a4d00;
  text-align: center;
  font-size: 23rpx;
}

.login-card {
  margin-top: 8vh;
  padding: 48rpx 36rpx;
  text-align: center;
}

.login-title,
.login-desc {
  display: block;
}

.login-title {
  font-size: 38rpx;
  font-weight: 650;
}

.login-desc {
  margin: 14rpx auto 28rpx;
  color: var(--cp-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.avatar-picker {
  width: 190rpx;
  margin: 0 auto 20rpx;
}

.avatar-button {
  width: 180rpx;
  margin: 0 auto;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: transparent;
  color: var(--cp-muted);
  font-size: 22rpx;
}

.avatar-alternate {
  width: 100%;
  min-height: 46rpx;
  margin-top: 4rpx;
  padding: 4rpx;
  background: transparent;
  color: var(--cp-accent);
  font-size: 19rpx;
}

.login-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
}

.nickname-input {
  margin-bottom: 18rpx;
  text-align: center;
}

.consent-row { margin: 18rpx 0; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6rpx; color: var(--cp-muted); font-size: 22rpx; }
.consent-row label { display: flex; align-items: center; }
.consent-row checkbox { transform: scale(.72); }
.legal-link { color: var(--cp-accent); }

.team-header {
  padding: 10rpx 6rpx 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow,
.page-title,
.page-desc,
.workspace-name,
.workspace-meta,
.invite-title,
.invite-desc,
.member-name,
.member-meta,
.member-expiry,
.invite-role,
.invite-time {
  display: block;
}

.eyebrow {
  color: var(--cp-accent);
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 0;
}

.page-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 650;
}

.page-desc {
  margin-top: 8rpx;
  color: var(--cp-muted);
  font-size: 23rpx;
}

.create-button {
  flex: none;
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--cp-border);
  background: var(--cp-surface);
  color: var(--cp-accent);
  font-size: 23rpx;
}

.accept-empty {
  margin-top: 12rpx;
}

.workspace-card {
  overflow: hidden;
  border: 1rpx solid var(--cp-border);
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end));
  color: var(--cp-ink);
  box-shadow: 0 12rpx 32rpx rgba(62, 52, 42, 0.07);
}

.workspace-picker {
  padding: 12rpx 32rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.workspace-picker > text {
  flex: none;
  margin-left: 18rpx;
  color: var(--cp-ink);
  font-size: 23rpx;
}

.workspace-picker > view,
.sheet-heading > view {
  flex: 1;
  min-width: 0;
}

.workspace-name {
  font-size: 34rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.workspace-meta {
  margin-top: 8rpx;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.workspace-actions {
  padding: 24rpx 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  border-top: 1rpx solid var(--cp-border);
}

.workspace-actions > button:only-child {
  grid-column: 1 / -1;
}

.workspace-card-top {
  padding: 20rpx 26rpx 0 32rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.workspace-edit {
  min-height: 60rpx;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--cp-border);
  background: rgba(255, 253, 250, .65);
  color: var(--cp-accent);
  font-size: 22rpx;
}

.invite-ready {
  margin-top: 22rpx;
  border-color: var(--cp-border);
  background: var(--cp-tint);
}

.invite-title {
  font-size: 29rpx;
  font-weight: 680;
  min-width: 0;
  overflow-wrap: anywhere;
}

.invite-desc {
  margin-top: 8rpx;
  color: var(--cp-muted);
  font-size: 22rpx;
}

.invite-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.invite-actions > button {
  flex: 1;
}

.invite-ready-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.invite-ready-head .invite-status {
  flex: none;
}

.invite-code-box {
  margin-top: 22rpx;
  padding: 20rpx;
  border: 1rpx solid var(--cp-border);
  border-radius: 18rpx;
  background: var(--cp-surface);
}

.invite-code-label,
.invite-code {
  display: block;
}

.invite-code-label {
  margin-bottom: 8rpx;
  color: var(--cp-muted);
  font-size: 20rpx;
}

.invite-code {
  color: var(--cp-ink);
  font-family: Menlo, Consolas, monospace;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-all;
}

.invite-inactive {
  background: #f5f7f6;
  border-color: #dfe6e1;
}

.invite-inactive .invite-code {
  color: var(--cp-muted);
}

.team-data-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff4dc;
  color: #7a4d00;
  font-size: 22rpx;
}

.team-data-error button {
  flex: none;
  min-height: 56rpx;
  padding: 10rpx 16rpx;
  background: transparent;
  color: #7a4d00;
  font-size: 22rpx;
}

.section-head {
  margin: 34rpx 8rpx 16rpx;
  display: flex;
  justify-content: space-between;
  color: var(--cp-muted);
  font-size: 24rpx;
  font-weight: 650;
}

.member-list,
.invite-list {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.member-row,
.invite-row {
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--cp-border);
}

.member-row:last-child,
.invite-row:last-child {
  border-bottom: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  flex: none;
  border-radius: 50%;
  background: var(--cp-tint);
}

.member-info {
  min-width: 0;
  flex: 1;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.member-name {
  overflow: hidden;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.self {
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  background: var(--cp-tint);
  color: var(--cp-accent);
  font-size: 18rpx;
}

.member-meta,
.member-expiry {
  margin-top: 6rpx;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.member-expiry {
  color: #8a650d;
}

.manage-button {
  min-height: 68rpx;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: var(--cp-tint);
  color: var(--cp-accent);
  font-size: 22rpx;
}

.locked {
  color: var(--cp-muted);
  font-size: 21rpx;
}

.invite-row {
  justify-content: space-between;
}

.invite-role {
  font-size: 26rpx;
  font-weight: 650;
}

.invite-time {
  margin-top: 6rpx;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.invite-status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f4f2;
  color: var(--cp-muted);
  font-size: 20rpx;
}

.invite-status.active {
  background: var(--cp-tint);
  color: var(--cp-accent);
}

.empty-list {
  padding: 32rpx 0;
  color: var(--cp-muted);
  text-align: center;
  font-size: 24rpx;
}

.safe-note {
  margin-top: 22rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(48, 43, 38, 0.36);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  border: 1rpx solid var(--cp-border);
  border-radius: 32rpx;
  background: var(--cp-surface);
}

.sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sheet-title,
.sheet-desc,
.field-label,
.sheet-hint,
.sheet-error {
  display: block;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 650;
}

.sheet-desc {
  margin-top: 8rpx;
  color: var(--cp-muted);
  font-size: 23rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.sheet-close {
  flex: none;
  width: 60rpx;
  min-height: 60rpx;
  padding: 0;
  border-radius: 18rpx;
  background: var(--cp-tint);
  color: var(--cp-muted);
  font-size: 36rpx;
}

.field-label {
  margin: 24rpx 0 14rpx;
  color: var(--cp-ink);
  font-size: 24rpx;
  font-weight: 650;
}

.theme-options {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6rpx;
}

.theme-option {
  min-width: 0;
  min-height: 112rpx;
  padding: 10rpx 2rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: transparent;
  color: var(--cp-muted);
  font-size: 19rpx;
}

.theme-option.selected {
  border-color: var(--cp-border);
  background: var(--cp-tint);
  color: var(--cp-ink);
}

.theme-dot {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid rgba(62, 52, 42, .08);
  color: var(--cp-ink);
  font-size: 28rpx;
}

.theme-preview {
  padding: 24rpx;
  margin-top: 22rpx;
  border: 1rpx solid var(--cp-border);
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end));
  color: var(--cp-muted);
  font-size: 20rpx;
}

.preview-name {
  display: block;
  margin-top: 12rpx;
  color: var(--cp-ink);
  font-size: 30rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.role-options {
  display: grid;
  gap: 10rpx;
}

.role-option {
  padding: 18rpx 22rpx;
  justify-content: space-between;
  gap: 12rpx;
  border: 2rpx solid var(--cp-border);
  border-radius: 18rpx;
  background: var(--cp-surface);
  text-align: left;
}

.role-option.selected {
  background: var(--cp-tint);
  border-color: var(--cp-accent);
}

.role-option-title,
.role-option-desc {
  display: block;
}

.role-option-title {
  color: var(--cp-ink);
  font-size: 26rpx;
  font-weight: 650;
}

.role-option-desc {
  margin-top: 6rpx;
  color: var(--cp-muted);
  font-size: 21rpx;
  font-weight: 400;
}

.option-check {
  flex: none;
  width: 34rpx;
  color: var(--cp-accent);
  font-size: 28rpx;
}

.duration-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.duration-option {
  min-height: 72rpx;
  padding: 12rpx 4rpx;
  border: 2rpx solid var(--cp-border);
  border-radius: 18rpx;
  background: var(--cp-surface);
  color: var(--cp-muted);
  font-size: 23rpx;
}

.duration-option.selected {
  background: var(--cp-tint);
  border-color: var(--cp-accent);
  color: var(--cp-accent);
}

.sheet-hint {
  margin-top: 20rpx;
  color: var(--cp-muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.sheet-error {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
  background: #fff1ee;
  color: #b42318;
  font-size: 23rpx;
  line-height: 1.5;
}

.sheet-submit {
  width: 100%;
  margin-top: 28rpx;
}

.join-field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.join-field-label .field-label {
  margin: 0;
}

.paste-button {
  min-height: 68rpx;
  padding: 12rpx 0 12rpx 18rpx;
  color: var(--cp-accent);
  background: transparent;
  font-size: 23rpx;
}

.join-code-input {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
}
