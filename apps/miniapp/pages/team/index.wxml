<view class="page" style="{{themeStyle}}">
  <view class="offline-bar" wx:if="{{offline}}">当前处于离线状态</view>

  <view class="card login-card" wx:if="{{needsLogin}}">
    <form bindsubmit="handleLogin">
      <text class="login-title">登录后管理团队</text>
      <text class="login-desc">登录只用于验证团队身份和记录必要的安全操作。</text>
      <text class="login-desc">新用户登录后需设置昵称和头像，即可开启密钥钱包。</text>
    <checkbox-group class="consent-row" bindchange="handleLegalConsent"><label><checkbox value="agree" checked="{{legalConsent}}" color="{{theme.accent}}" /><text>我已阅读并同意</text></label><text class="legal-link" bindtap="goPrivacy">《隐私政策》</text><text>和</text><text class="legal-link" bindtap="goTerms">《用户协议》</text></checkbox-group>
      <button class="button-primary" form-type="submit" loading="{{loginLoading}}" disabled="{{loginLoading || avatarProcessing || !legalConsent}}">微信快捷登录</button>
    </form>
  </view>

  <block wx:if="{{!needsLogin}}">
    <view class="team-header">
      <view>
        <text class="eyebrow">TEAM WORKSPACE</text>
        <text class="page-title">{{isDetail ? '团队详情' : '我的团队'}}</text>
        <text class="page-desc">{{isDetail ? '团队设置、成员与邀请' : '每一处协作，都有自己的空间。'}}</text>
      </view>
    </view>

    <view class="card state-card" wx:if="{{loading}}">
      <text class="state-symbol">···</text>
      <text class="state-title">正在同步团队与成员</text>
      <text class="state-desc">权限变更会在同步完成后立即生效。</text>
    </view>

    <view class="card state-card" wx:elif="{{error}}">
      <text class="state-symbol">!</text>
      <text class="state-title">团队加载失败</text>
      <text class="state-desc">{{error}}</text>
      <button class="button-secondary" bindtap="handleRetry">重新加载</button>
      <button class="button-ghost" wx:if="{{isDetail}}" bindtap="handleBackToTeams">返回团队列表</button>
    </view>

    <view class="team-cards" wx:elif="{{!isDetail}}">
      <view class="list-summary"><text>{{teams.length ? '已加入 ' + teams.length + ' 个团队' : '还没有团队，从这里开始协作'}}</text><text wx:if="{{teams.length}}">点击卡片查看详情</text></view>
      <button class="team-card" wx:for="{{teams}}" wx:key="teamId" style="{{item.cardStyle}}" data-teamid="{{item.teamId}}" bindtap="handleOpenTeam" aria-label="查看{{item.name}}的团队详情">
        <view class="team-card-top"><text class="team-role">{{item.roleLabel}}</text><text class="current-badge" wx:if="{{activeTeamId === item.teamId}}">当前空间</text></view>
        <view class="team-card-main"><text class="team-card-name">{{item.name}}</text><text class="team-card-arrow">›</text></view>
        <text class="team-card-meta">{{item.memberCount}} 位成员 · {{item.itemCount}} 项内容</text>
      </button>
      <button class="add-team-card" bindtap="handleAddTeam" aria-label="添加团队，创建或加入团队"><text class="add-team-plus">＋</text><text class="add-team-title">添加团队</text><text class="add-team-desc">创建新的协作空间，或通过邀请码加入</text></button>
    </view>

    <block wx:else>
      <view class="workspace-card">
        <view class="workspace-card-top">
          <text>{{activeTeamId === currentTeam.teamId ? '当前团队空间' : '团队空间'}}</text>
          <button class="workspace-edit" wx:if="{{canManage}}" bindtap="handleEditTeam" aria-label="编辑团队名称和主题色">编辑</button>
        </view>
          <view class="workspace-picker">
            <view>
              <text class="workspace-name">{{currentTeam.name}}</text>
              <text class="workspace-meta">{{currentRoleLabel}} · {{currentTeam.memberCount}} 位成员 · {{currentTeam.itemCount}} 项内容</text>
            </view>
          </view>
        <view class="workspace-actions">
          <button class="button-primary" bindtap="handleEnterWorkspace">进入密钥</button>
          <button class="button-secondary" wx:if="{{canManage}}" loading="{{inviteCreating}}" disabled="{{inviteCreating}}" bindtap="handleInvite">邀请成员</button>
        </view>
      </view>

      <view class="card invite-ready {{inviteUsable ? '' : 'invite-inactive'}}" wx:if="{{inviteToken}}">
        <view class="invite-ready-head"><text class="invite-title">邀请加入 {{currentTeam.name}}</text><text class="invite-status {{inviteUsable ? 'active' : ''}}">{{inviteStatusText}}</text></view>
        <text class="invite-desc">{{inviteRoleLabel}}权限 · 有效至 {{inviteExpiresText}}</text>
        <view class="invite-code-box"><text class="invite-code-label">邀请码</text><text class="invite-code" selectable="true" user-select="true">{{inviteToken}}</text></view>
        <text class="invite-desc">每个邀请码仅可领取一次，请发送给你信任的队友。</text>
        <view class="invite-actions">
          <button class="button-primary button-small" open-type="share" wx:if="{{inviteUsable}}">微信分享</button>
          <button class="button-primary button-small" wx:else bindtap="handleInvite">重新生成</button>
          <button class="button-ghost button-small" disabled="{{!inviteUsable || inviteCopying}}" loading="{{inviteCopying}}" bindtap="handleCopyInvite">复制邀请码</button>
        </view>
      </view>

      <view class="team-data-error" wx:if="{{teamDataError}}"><text>{{teamDataError}}</text><button bindtap="loadTeamData" disabled="{{teamDataLoading}}">重试</button></view>
      <view class="section-head"><text>团队成员</text><text>{{members.length}} 位</text></view>
      <view class="card member-list">
        <view class="empty-list" wx:if="{{!members.length}}">{{teamDataLoading ? '正在同步成员…' : teamDataError ? '成员信息暂未加载' : '正在等待成员加入'}}</view>
        <block wx:for="{{members}}" wx:key="userId">
          <view class="member-row">
            <image class="avatar" src="{{item.avatarUrl || '/assets/avatar-default.png'}}" mode="aspectFill" />
            <view class="member-info">
              <view class="member-name-row"><text class="member-name">{{item.nickname || '未命名成员'}}</text><text class="self" wx:if="{{item.isSelf}}">我</text></view>
              <text class="member-meta">{{item.roleLabel}} · {{item.joinedText}} 加入</text>
              <text class="member-expiry" wx:if="{{item.expiresText}}">权限至 {{item.expiresText}}</text>
            </view>
            <button class="manage-button" wx:if="{{item.manageable}}" data-userid="{{item.userId}}" bindtap="handleMemberAction">管理</button>
            <text class="locked" wx:else>{{item.role === 'owner' ? '所有者' : ''}}</text>
          </view>
        </block>
      </view>

      <block wx:if="{{canManage}}">
        <view class="section-head"><text>最近邀请</text><text>{{invites.length}} 条</text></view>
        <view class="card invite-list">
          <view class="empty-list" wx:if="{{!invites.length}}">{{teamDataLoading ? '正在同步邀请…' : teamDataError ? '邀请信息暂未加载' : '暂无邀请记录'}}</view>
          <block wx:for="{{invites}}" wx:key="id">
            <view class="invite-row">
              <view><text class="invite-role">{{item.roleLabel}}</text><text class="invite-time">有效至 {{item.expiresText}}</text></view>
              <text class="invite-status {{item.active ? 'active' : ''}}">{{item.statusText}}</text>
            </view>
          </block>
        </view>
      </block>

      <view class="safe-note">权限变更会立即影响访问并写入审计。所有者不可被移除或降级；访客仅可查看。</view>
    </block>
  </block>

  <view class="sheet-mask" wx:if="{{teamEditorOpen}}" bindtap="handleCloseTeamEditor" catchtouchmove="handleSheetTap">
    <view class="sheet" catchtap="handleSheetTap">
      <form bindsubmit="handleSaveTeam">
        <view class="sheet-heading"><view><text class="sheet-title">编辑团队</text><text class="sheet-desc">名称和主题色会对团队所有成员生效。</text></view><button class="sheet-close" bindtap="handleCloseTeamEditor" disabled="{{teamSaving}}" aria-label="关闭编辑团队">×</button></view>
        <text class="field-label">团队名称</text>
        <input class="input team-name-input" name="teamName" value="{{teamNameDraft}}" maxlength="48" placeholder="输入 2-48 个字符" disabled="{{teamSaving}}" bindinput="handleTeamNameInput" />
        <text class="field-label">主题色</text>
        <view class="theme-options">
          <button wx:for="{{themeColors}}" wx:key="value" class="theme-option {{teamColorDraft === item.value ? 'selected' : ''}}" data-color="{{item.value}}" bindtap="handleThemeChange" disabled="{{teamSaving}}" aria-label="{{item.label}}{{teamColorDraft === item.value ? '，已选择' : ''}}"><view class="theme-dot" style="background: {{item.swatch}}; color: {{item.accent}};"><text wx:if="{{teamColorDraft === item.value}}">✓</text></view><text>{{item.label}}</text></button>
        </view>
        <view class="theme-preview" style="{{teamPreviewStyle}}"><text>团队空间预览</text><text class="preview-name">{{teamNameDraft || '团队名称'}}</text></view>
        <text class="sheet-error" wx:if="{{teamEditError}}">{{teamEditError}}</text>
        <button class="button-primary sheet-submit" form-type="submit" loading="{{teamSaving}}" disabled="{{teamSaving}}">保存设置</button>
      </form>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{inviteComposerOpen}}" bindtap="handleCloseInviteComposer" catchtouchmove="handleSheetTap">
    <view class="sheet" catchtap="handleSheetTap">
      <view class="sheet-heading"><view><text class="sheet-title">邀请队友</text><text class="sheet-desc">加入 {{currentTeam.name}}</text></view><button class="sheet-close" bindtap="handleCloseInviteComposer" disabled="{{inviteCreating}}" aria-label="关闭邀请设置">×</button></view>
      <text class="field-label">加入后的权限</text>
      <view class="role-options">
        <button wx:for="{{inviteRoles}}" wx:key="value" class="role-option {{selectedInviteRole === item.value ? 'selected' : ''}}" data-role="{{item.value}}" bindtap="handleInviteRoleChange" disabled="{{inviteCreating}}"><view><text class="role-option-title">{{item.label}}</text><text class="role-option-desc">{{item.help}}</text></view><text class="option-check">{{selectedInviteRole === item.value ? '✓' : ''}}</text></button>
      </view>
      <text class="field-label">邀请码有效期</text>
      <view class="duration-options"><button wx:for="{{inviteDurations}}" wx:key="hours" class="duration-option {{selectedInviteHours === item.hours ? 'selected' : ''}}" data-hours="{{item.hours}}" bindtap="handleInviteDurationChange" disabled="{{inviteCreating}}">{{item.label}}</button></view>
      <text class="sheet-hint">生成后可直接分享到微信，也可以复制邀请码。</text>
      <text class="sheet-error" wx:if="{{inviteError}}">{{inviteError}}</text>
      <button class="button-primary sheet-submit" bindtap="handleGenerateInvite" loading="{{inviteCreating}}" disabled="{{inviteCreating}}">生成邀请码</button>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{!isDetail && joinOpen}}" bindtap="handleCloseJoin" catchtouchmove="handleSheetTap">
    <view class="sheet" catchtap="handleSheetTap">
      <form bindsubmit="handleJoinTeam">
        <view class="sheet-heading"><view><text class="sheet-title">加入团队</text><text class="sheet-desc">填写队友发来的邀请码，验证后加入。</text></view><button class="sheet-close" bindtap="handleCloseJoin" disabled="{{joinLoading || joinPasting}}" aria-label="关闭加入团队">×</button></view>
        <view class="join-field-label"><text class="field-label">邀请码</text><button class="paste-button" bindtap="handlePasteJoin" loading="{{joinPasting}}" disabled="{{joinLoading || joinPasting}}">粘贴邀请码</button></view>
        <input class="input join-code-input" name="inviteToken" value="{{joinToken}}" maxlength="256" placeholder="输入或粘贴完整邀请码" disabled="{{joinLoading || joinPasting}}" bindinput="handleJoinTokenInput" />
        <text class="sheet-error" wx:if="{{joinError}}">{{joinError}}</text>
        <button class="button-primary sheet-submit" form-type="submit" loading="{{joinLoading}}" disabled="{{joinLoading || joinPasting}}">验证并加入</button>
      </form>
    </view>
  </view>
</view>
