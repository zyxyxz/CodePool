<view wx:if="{{!vaultLocked}}">
<view class="page home-page" style="{{themeStyle}}">
  <view class="offline-bar" wx:if="{{offline}}">当前处于离线状态，已展示的信息可能不是最新</view>

  <view class="platform-notice {{maintenanceMode ? 'maintenance' : ''}}" wx:if="{{announcement || maintenanceMode}}">
    <text class="notice-label">{{maintenanceMode ? '系统维护中' : '平台公告'}}</text>
    <text class="notice-content">{{announcement || '部分新增与变更操作暂不可用，请稍后再试。'}}</text>
  </view>

  <view class="card login-card" wx:if="{{needsLogin}}">
    <form bindsubmit="handleLogin">
    <view class="brand-mark">CP</view>
    <view class="login-title">进入 {{workspaceName}}</view>
    <view class="login-desc">使用微信身份建立成员会话；不会读取通讯录、手机号或聊天记录。</view>
    <text class="login-desc">新用户登录后需设置昵称和头像，即可开启密钥钱包。</text>
    <checkbox-group class="consent-row" bindchange="handleLegalConsent"><label><checkbox value="agree" checked="{{legalConsent}}" color="{{theme.accent}}" /><text>我已阅读并同意</text></label><text class="legal-link" bindtap="goPrivacy">《隐私政策》</text><text>和</text><text class="legal-link" bindtap="goTerms">《用户协议》</text></checkbox-group>
    <button class="button-primary login-button" form-type="submit" loading="{{loginLoading}}" disabled="{{loginLoading || avatarProcessing || !legalConsent}}">微信快捷登录</button>
    <view class="login-context"><text>仅处理身份识别、团队协作和必要审计信息</text><text>登录后可在“我的”中管理资料和退出本机</text></view>
    </form>
  </view>

  <block wx:if="{{!needsLogin}}">
    <view class="home-masthead">
      <view class="wordmark">{{workspaceName}}</view>
      <view class="masthead-note"><view class="privacy-dot" /><text>团队私享空间</text></view>
    </view>
    <view class="hero-card">
      <view class="hero-top">
        <view class="space-caption"><view class="space-dot" /><text>当前空间</text></view>
        <view class="hero-tools">
          <button class="hero-tool" bindtap="handleRetry" aria-label="刷新密钥">↻</button>
          <button class="hero-tool hero-tool-primary {{maintenanceMode ? 'maintenance' : ''}}" wx:if="{{teams.length && !loading}}" bindtap="handleAdd" aria-label="{{maintenanceMode ? '系统维护中' : '新增密钥内容'}}">＋</button>
        </view>
      </view>
      <picker wx:if="{{teams.length}}" mode="selector" range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="handleTeamChange">
        <view class="team-picker">
          <view>
            <text class="team-name">{{currentTeam.name}}</text>
            <text class="team-meta">代码与密钥，在这里安心协作</text>
          </view>
          <text class="picker-arrow">切换空间 ›</text>
        </view>
      </picker>
      <view class="empty-space-title" wx:else>你的协作空间</view>
      <view class="space-footer" wx:if="{{currentTeam}}">
        <view class="space-stats"><text>{{currentTeam.itemCount}} 项内容</text><text class="stat-separator">·</text><text>{{currentTeam.memberCount}} 位成员</text></view>
        <text class="space-role">{{currentTeam.role === 'owner' ? '所有者' : currentTeam.role === 'admin' ? '管理员' : currentTeam.role === 'member' ? '成员' : '访客'}}</text>
      </view>
    </view>

    <view class="search-row" wx:if="{{teams.length}}">
      <view class="search-icon" />
      <input class="search-input" confirm-type="search" maxlength="80" placeholder="在当前空间搜索" placeholder-style="color: {{theme.muted}}" value="{{query}}" bindinput="handleSearchInput" bindconfirm="handleSearchConfirm" />
      <button class="clear-search" wx:if="{{query}}" bindtap="handleSearchClear" aria-label="清除搜索">清除</button>
    </view>

    <scroll-view class="filter-scroll" scroll-x enable-flex wx:if="{{teams.length}}">
      <view class="filter-row">
        <block wx:for="{{filters}}" wx:key="value">
          <button class="filter-chip {{activeFilter === item.value ? 'active' : ''}}" data-filter="{{item.value}}" bindtap="handleFilter">{{item.label}}</button>
        </block>
      </view>
    </scroll-view>

    <view class="card state-card" wx:if="{{loading}}">
      <view class="state-symbol loading-dot">···</view>
      <text class="state-title">正在同步密钥</text>
      <text class="state-desc">正在校验权限并同步必要元数据；敏感正文不会自动读取。</text>
    </view>

    <view class="card state-card" wx:elif="{{error}}">
      <view class="state-symbol">!</view>
      <text class="state-title">暂时无法加载</text>
      <text class="state-desc">{{error}}</text>
      <button class="button-secondary" bindtap="handleRetry">重新加载</button>
    </view>

    <view class="card state-card" wx:elif="{{!teams.length}}">
      <view class="state-symbol">+</view>
      <text class="state-title">先创建或加入一个团队</text>
      <text class="state-desc">团队决定成员权限和内容可见范围。创建后即可添加内容并邀请同事协作。</text>
      <button class="button-primary" bindtap="goTeam">前往团队</button>
    </view>

    <view class="card state-card" wx:elif="{{resultCount === 0}}">
      <view class="state-symbol">∅</view>
      <text class="state-title">{{query ? '没有匹配内容' : '密钥还是空的'}}</text>
      <text class="state-desc">{{query ? '换一个关键词或筛选条件试试。' : '添加第一条代码、密文或动态验证码。'}}</text>
      <button class="button-primary" wx:if="{{!query}}" bindtap="handleAdd">添加第一项内容</button>
      <button class="button-secondary" wx:else bindtap="handleSearchClear">清除搜索</button>
    </view>

    <block wx:else>
      <view class="section-head" wx:if="{{visibleAccounts.length}}">
        <text>动态验证码</text><text>{{visibleAccounts.length}} 项</text>
      </view>
      <block wx:for="{{visibleAccounts}}" wx:key="id">
        <view class="card account-card" data-id="{{item.id}}" bindtap="goAccountDetail" hover-class="card-hover">
          <view class="card-main">
            <view class="card-info">
              <text class="kind-badge totp">动态码</text>
              <text class="item-title">{{item.issuer}}</text>
              <text class="item-subtitle">{{item.label}}</text>
              <text class="item-identifier" wx:if="{{item.accountIdentifier}}">{{item.accountIdentifier}}</text>
            </view>
          </view>
          <view class="card-actions">
            <view class="totp-area">
              <text class="totp-code {{item.revealed ? 'revealed' : ''}}">{{item.codeDisplay}}</text>
              <text class="totp-time">{{item.revealed ? item.expiresIn + ' 秒后更新' : '已安全遮挡'}}</text>
            </view>
            <view class="code-tools">
              <button class="mini-action" data-id="{{item.id}}" loading="{{item.codeLoading}}" catchtap="handleRevealCode">{{item.revealed ? '隐藏' : '查看'}}</button>
              <button class="mini-action primary" data-id="{{item.id}}" catchtap="handleCopyCode">复制</button>
            </view>
          </view>
          <progress wx:if="{{item.revealed}}" percent="{{item.progress}}" stroke-width="3" activeColor="{{theme.accent}}" backgroundColor="{{theme.tint}}" />
        </view>
      </block>

      <view class="section-head" wx:if="{{visibleVaultItems.length}}">
        <text>共享内容</text><text>{{visibleVaultItems.length}} 项</text>
      </view>
      <block wx:for="{{visibleVaultItems}}" wx:key="id">
        <view class="card vault-card" data-id="{{item.id}}" bindtap="goItemDetail" hover-class="card-hover">
          <view class="vault-top">
            <text class="kind-badge {{item.kind}}">{{item.kindLabel}}</text>
            <text class="expiry">{{item.expiryText}}</text>
          </view>
          <text class="item-title">{{item.title}}</text>
          <text class="item-subtitle" wx:if="{{item.identifier}}">{{item.identifier}}</text>
          <view class="vault-meta">
            <text>{{item.language || '安全加密'}}</text>
            <text>{{item.updatedText}} 更新</text>
            <text>查看 ›</text>
          </view>
        </view>
      </block>
    </block>
  </block>
</view>
</view>
<view wx:else class="vault-curtain">CodePool · 已锁定</view>
