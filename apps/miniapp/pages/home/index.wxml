<view class="page">
  <view class="offline-bar" wx:if="{{offline}}">当前处于离线状态，已展示的信息可能不是最新</view>

  <view class="platform-notice {{maintenanceMode ? 'maintenance' : ''}}" wx:if="{{announcement || maintenanceMode}}">
    <text class="notice-label">{{maintenanceMode ? '系统维护中' : '平台公告'}}</text>
    <text class="notice-content">{{announcement || '部分新增与变更操作暂不可用，请稍后再试。'}}</text>
  </view>

  <view class="card login-card" wx:if="{{needsLogin}}">
    <view class="brand-mark">CP</view>
    <view class="login-title">进入 {{workspaceName}}</view>
    <view class="login-desc">微信登录仅用于识别团队成员。不会读取通讯录、手机号或聊天记录。</view>
    <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" aria-label="选择头像">
      <image class="login-avatar" src="{{loginProfile.avatarUrl || '/assets/avatar-default.png'}}" mode="aspectFill" />
      <text>更换头像</text>
    </button>
    <input class="input nickname-input" type="nickname" maxlength="64" value="{{loginProfile.nickname}}" placeholder="你的昵称" bindinput="handleNicknameInput" />
    <checkbox-group class="consent-row" bindchange="handleLegalConsent"><label><checkbox value="agree" checked="{{legalConsent}}" color="#15803D" /><text>我已阅读并同意</text></label><text class="legal-link" bindtap="goPrivacy">《隐私政策》</text><text>和</text><text class="legal-link" bindtap="goTerms">《用户协议》</text></checkbox-group>
    <button class="button-primary login-button" loading="{{loginLoading}}" disabled="{{loginLoading || !legalConsent}}" bindtap="handleLogin">微信快捷登录</button>
    <view class="privacy-copy">微信登录仅处理完成身份识别、团队协作和安全审计所需的信息。</view>
  </view>

  <block wx:if="{{!needsLogin}}">
    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="eyebrow">CODEPOOL WORKSPACE</view>
          <view class="hero-title">{{workspaceName}}</view>
          <view class="hero-subtitle">代码片段、临时密文与动态验证码</view>
        </view>
        <button class="refresh-button" bindtap="handleRetry" aria-label="刷新代码池">刷新</button>
      </view>
      <picker wx:if="{{teams.length}}" mode="selector" range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="handleTeamChange">
        <view class="team-picker">
          <view>
            <text class="team-name">{{currentTeam.name}}</text>
            <text class="team-meta">{{currentTeam.memberCount}} 位成员 · {{currentTeam.itemCount}} 项内容 · {{currentTeam.role === 'owner' ? '所有者' : currentTeam.role === 'admin' ? '管理员' : currentTeam.role === 'member' ? '成员' : '访客'}}</text>
          </view>
          <text class="picker-arrow">切换 ›</text>
        </view>
      </picker>
    </view>

    <view class="search-row" wx:if="{{teams.length}}">
      <input class="search-input" confirm-type="search" maxlength="80" placeholder="搜索标题、账号或标识" value="{{query}}" bindinput="handleSearchInput" bindconfirm="handleSearchConfirm" />
      <button class="clear-search" wx:if="{{query}}" bindtap="handleSearchClear" aria-label="清除搜索">清除</button>
    </view>

    <scroll-view class="filter-scroll" scroll-x enable-flex wx:if="{{teams.length}}">
      <view class="filter-row">
        <block wx:for="{{filters}}" wx:key="value">
          <button class="filter-chip {{activeFilter === item.value ? 'active' : ''}}" data-filter="{{item.value}}" bindtap="handleFilter">{{item.label}}</button>
        </block>
      </view>
    </scroll-view>

    <view class="card state-card" wx:if="{{loading}}">
      <view class="state-symbol loading-dot">···</view>
      <text class="state-title">正在同步代码池</text>
      <text class="state-desc">敏感正文只会在你主动查看后解密。</text>
    </view>

    <view class="card state-card" wx:elif="{{error}}">
      <view class="state-symbol">!</view>
      <text class="state-title">暂时无法加载</text>
      <text class="state-desc">{{error}}</text>
      <button class="button-secondary" bindtap="handleRetry">重新加载</button>
    </view>

    <view class="card state-card" wx:elif="{{!teams.length}}">
      <view class="state-symbol">+</view>
      <text class="state-title">创建第一个团队代码池</text>
      <text class="state-desc">创建团队后即可添加内容并邀请同事协作。</text>
      <button class="button-primary" bindtap="goTeam">创建团队</button>
    </view>

    <view class="card state-card" wx:elif="{{resultCount === 0}}">
      <view class="state-symbol">∅</view>
      <text class="state-title">{{query ? '没有匹配内容' : '代码池还是空的'}}</text>
      <text class="state-desc">{{query ? '换一个关键词或筛选条件试试。' : '添加第一条代码、密文或动态验证码。'}}</text>
      <button class="button-primary" wx:if="{{!query}}" bindtap="handleAdd">添加内容</button>
      <button class="button-secondary" wx:else bindtap="handleSearchClear">清除搜索</button>
    </view>

    <block wx:else>
      <view class="section-head" wx:if="{{visibleAccounts.length}}">
        <text>动态验证码</text><text>{{visibleAccounts.length}} 项</text>
      </view>
      <block wx:for="{{visibleAccounts}}" wx:key="id">
        <view class="card account-card" data-id="{{item.id}}" bindtap="goAccountDetail" hover-class="card-hover">
          <view class="card-main">
            <view class="card-info">
              <text class="kind-badge totp">动态码</text>
              <text class="item-title">{{item.issuer}}</text>
              <text class="item-subtitle">{{item.label}}</text>
              <text class="item-identifier" wx:if="{{item.accountIdentifier}}">{{item.accountIdentifier}}</text>
            </view>
            <view class="totp-area">
              <text class="totp-code {{item.revealed ? 'revealed' : ''}}">{{item.codeDisplay}}</text>
              <text class="totp-time">{{item.revealed ? item.expiresIn + ' 秒后更新' : '点击查看时才解密'}}</text>
            </view>
          </view>
          <progress wx:if="{{item.revealed}}" percent="{{item.progress}}" stroke-width="3" activeColor="#15803D" backgroundColor="#E0EBE3" />
          <view class="card-actions">
            <button class="mini-action" data-id="{{item.id}}" loading="{{item.codeLoading}}" catchtap="handleRevealCode">{{item.revealed ? '隐藏' : '查看'}}</button>
            <button class="mini-action primary" data-id="{{item.id}}" catchtap="handleCopyCode">复制动态码</button>
          </view>
        </view>
      </block>

      <view class="section-head" wx:if="{{visibleVaultItems.length}}">
        <text>共享内容</text><text>{{visibleVaultItems.length}} 项</text>
      </view>
      <block wx:for="{{visibleVaultItems}}" wx:key="id">
        <view class="card vault-card" data-id="{{item.id}}" bindtap="goItemDetail" hover-class="card-hover">
          <view class="vault-top">
            <text class="kind-badge {{item.kind}}">{{item.kindLabel}}</text>
            <text class="expiry">{{item.expiryText}}</text>
          </view>
          <text class="item-title">{{item.title}}</text>
          <text class="item-subtitle" wx:if="{{item.identifier}}">{{item.identifier}}</text>
          <view class="vault-meta">
            <text>{{item.language || '安全加密'}}</text>
            <text>{{item.updatedText}} 更新</text>
            <text>查看 ›</text>
          </view>
        </view>
      </block>
    </block>

    <button class="add-button {{maintenanceMode ? 'disabled' : ''}}" wx:if="{{teams.length && !loading}}" bindtap="handleAdd" aria-label="添加代码池内容">{{maintenanceMode ? '维护中' : '＋ 添加'}}</button>
  </block>
</view>
