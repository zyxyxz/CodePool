.page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.offline-bar {
  margin: -28rpx -28rpx 20rpx;
  padding: 16rpx 28rpx;
  background: #fff4dc;
  color: #7a4d00;
  font-size: 23rpx;
  text-align: center;
}

.login-card {
  margin-top: 8vh;
  padding: 52rpx 36rpx;
  text-align: center;
}

.brand-mark {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #101820;
  color: #7ce79d;
  font-size: 34rpx;
  font-weight: 800;
}

.login-title {
  font-size: 40rpx;
  font-weight: 750;
}

.login-desc {
  margin: 16rpx auto 32rpx;
  max-width: 560rpx;
  color: #66736b;
  font-size: 25rpx;
  line-height: 1.65;
}

.avatar-button {
  width: 180rpx;
  margin: 0 auto 24rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: transparent;
  color: #66736b;
  font-size: 22rpx;
}

.login-avatar {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #edf3ef;
  border-radius: 50%;
}

.nickname-input {
  margin-bottom: 20rpx;
  text-align: center;
}

.login-button {
  width: 100%;
}

.consent-row {
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6rpx;
  color: #66736b;
  font-size: 22rpx;
}

.consent-row label {
  display: flex;
  align-items: center;
}

.consent-row checkbox {
  transform: scale(0.72);
}

.legal-link {
  color: #15803d;
}

.privacy-copy {
  margin-top: 24rpx;
  color: #89958e;
  font-size: 21rpx;
  line-height: 1.55;
}

.hero-card {
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  background: #101820;
  color: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(16, 24, 32, 0.18);
}

.hero-top {
  padding: 34rpx 32rpx 28rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  color: #7ce79d;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 750;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #aeb9b2;
  font-size: 24rpx;
}

.refresh-button {
  min-height: 68rpx;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #26332c;
  color: #dce8df;
  font-size: 23rpx;
}

.team-picker {
  padding: 26rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
}

.team-name,
.team-meta {
  display: block;
}

.team-name {
  font-size: 29rpx;
  font-weight: 650;
}

.team-meta {
  margin-top: 6rpx;
  color: #9eaaa3;
  font-size: 21rpx;
}

.picker-arrow {
  color: #7ce79d;
  font-size: 23rpx;
}

.search-row {
  position: relative;
  margin-bottom: 16rpx;
}

.platform-notice {
  margin-bottom: 20rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #cfe4d5;
  border-radius: 22rpx;
  background: #edf8f0;
  color: #385643;
}

.platform-notice.maintenance {
  border-color: #f0d396;
  background: #fff7e6;
  color: #765000;
}

.notice-label,
.notice-content {
  display: block;
}

.notice-label {
  font-size: 23rpx;
  font-weight: 700;
}

.notice-content {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.search-input {
  height: 92rpx;
  padding: 0 116rpx 0 28rpx;
  border: 1rpx solid #dae5de;
  border-radius: 24rpx;
  background: #ffffff;
}

.clear-search {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  min-height: 72rpx;
  padding: 12rpx 18rpx;
  background: transparent;
  color: #66736b;
  font-size: 23rpx;
}

.filter-scroll {
  width: calc(100% + 28rpx);
  margin-bottom: 18rpx;
  white-space: nowrap;
}

.filter-row {
  padding-right: 28rpx;
  display: inline-flex;
  gap: 12rpx;
}

.filter-chip {
  min-height: 68rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #e8eee9;
  color: #536058;
  font-size: 24rpx;
  font-weight: 550;
}

.filter-chip.active {
  background: #17231d;
  color: #ffffff;
}

.section-head {
  margin: 32rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #5c6b62;
  font-size: 24rpx;
  font-weight: 650;
}

.account-card,
.vault-card {
  padding: 26rpx;
}

.card-hover {
  opacity: 0.78;
}

.card-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-info {
  min-width: 0;
  flex: 1;
}

.kind-badge {
  align-self: flex-start;
  padding: 7rpx 14rpx;
  border-radius: 10rpx;
  background: #edf7f0;
  color: #166534;
  font-size: 20rpx;
  font-weight: 700;
}

.kind-badge.secret {
  background: #fff1f0;
  color: #a92920;
}

.kind-badge.code {
  background: #fff6dd;
  color: #805400;
}

.kind-badge.note {
  background: #eef3ff;
  color: #31599a;
}

.item-title,
.item-subtitle,
.item-identifier {
  display: block;
}

.item-title {
  margin-top: 14rpx;
  overflow: hidden;
  color: #17231d;
  font-size: 31rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: #66736b;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-identifier {
  margin-top: 6rpx;
  color: #89958e;
  font-size: 22rpx;
}

.totp-area {
  min-width: 244rpx;
  text-align: right;
}

.totp-code,
.totp-time {
  display: block;
}

.totp-code {
  color: #7b8981;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: 4rpx;
}

.totp-code.revealed {
  color: #15803d;
}

.totp-time {
  margin-top: 10rpx;
  color: #89958e;
  font-size: 20rpx;
}

.account-card progress {
  margin-top: 22rpx;
}

.card-actions {
  margin-top: 22rpx;
  padding-top: 18rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  border-top: 1rpx solid #edf1ee;
}

.mini-action {
  min-height: 68rpx;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: #f0f4f1;
  color: #536058;
  font-size: 23rpx;
}

.mini-action.primary {
  background: #edf7f0;
  color: #166534;
}

.vault-top,
.vault-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vault-top {
  justify-content: space-between;
}

.expiry {
  color: #89958e;
  font-size: 21rpx;
}

.vault-meta {
  margin-top: 22rpx;
  color: #89958e;
  font-size: 21rpx;
}

.vault-meta text:last-child {
  margin-left: auto;
  color: #15803d;
}

.add-button {
  position: fixed;
  right: 28rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 10;
  min-width: 190rpx;
  min-height: 88rpx;
  padding: 20rpx 30rpx;
  border-radius: 999rpx;
  background: #15803d;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(21, 128, 61, 0.28);
}

.add-button.disabled {
  background: #765000;
  box-shadow: 0 16rpx 36rpx rgba(118, 80, 0, 0.2);
}

.loading-dot {
  letter-spacing: 8rpx;
}
