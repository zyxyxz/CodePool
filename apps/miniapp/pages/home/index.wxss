.home-page { padding-top: 22rpx; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.home-masthead { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin: 0 4rpx 30rpx; }
.wordmark { flex: 1; min-width: 0; color: var(--cp-ink); font-family: Georgia, "Times New Roman", serif; font-size: 39rpx; font-weight: 600; overflow-wrap: anywhere; }
.masthead-note { display: flex; align-items: center; gap: 10rpx; color: var(--cp-muted); font-size: 21rpx; flex: none; }
.privacy-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #B59A6B; }

.hero-card { position: relative; overflow: hidden; margin-bottom: 28rpx; border: 1rpx solid var(--cp-border); border-radius: 32rpx; background: linear-gradient(125deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-ink); box-shadow: 0 12rpx 34rpx rgba(60, 47, 38, .04); }
.hero-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 28rpx 8rpx; }
.space-caption { display: flex; align-items: center; gap: 12rpx; color: var(--cp-accent); font-size: 22rpx; font-weight: 600; }
.space-dot { height: 15rpx; width: 15rpx; border-radius: 50%; background: var(--cp-accent); box-shadow: 0 0 0 6rpx rgba(255,255,255,.38); }
.hero-tools { display: flex; flex: none; gap: 12rpx; }
.hero-tool { width: 68rpx; min-width: 68rpx; height: 68rpx; min-height: 68rpx; padding: 0; border-radius: 20rpx; background: rgba(255,255,255,.6); color: var(--cp-accent); font-size: 34rpx; }
.hero-tool-primary { background: var(--cp-accent); color: #fff; }
.hero-tool-primary.maintenance { background: #8B692F; }
.team-picker { padding: 20rpx 30rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 22rpx; }
.team-picker > view { flex: 1; min-width: 0; }
.team-name { display: block; color: var(--cp-ink); font-size: 44rpx; font-weight: 650; line-height: 1.32; word-break: break-all; }
.team-meta { display: block; margin-top: 12rpx; color: var(--cp-muted); font-size: 22rpx; line-height: 1.6; }
.picker-arrow { flex: none; padding: 12rpx 0 12rpx 10rpx; color: var(--cp-accent); font-size: 22rpx; font-weight: 550; }
.empty-space-title { padding: 22rpx 30rpx 38rpx; font-size: 42rpx; font-weight: 600; }
.space-footer { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; border-top: 1rpx solid var(--cp-border); padding: 20rpx 30rpx; background: rgba(255,255,255,.3); }
.space-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; color: var(--cp-muted); font-size: 22rpx; }
.stat-separator { color: var(--cp-accent); }
.space-role { flex: none; padding: 6rpx 16rpx; border: 1rpx solid var(--cp-border); border-radius: 999rpx; color: var(--cp-accent); font-size: 20rpx; background: rgba(255,255,255,.5); }

.search-row { position: relative; margin-bottom: 20rpx; }
.search-input { height: 90rpx; padding: 0 106rpx 0 76rpx; border: 1rpx solid var(--cp-border); border-radius: 24rpx; background: var(--cp-surface); color: var(--cp-ink); font-size: 25rpx; }
.search-icon { position: absolute; top: 31rpx; left: 29rpx; width: 24rpx; height: 24rpx; border: 2rpx solid var(--cp-muted); border-radius: 50%; pointer-events: none; }
.search-icon::after { content: ''; position: absolute; width: 11rpx; height: 2rpx; right: -8rpx; bottom: -4rpx; background: var(--cp-muted); transform: rotate(45deg); }
.clear-search { position: absolute; top: 9rpx; right: 10rpx; min-height: 72rpx; padding: 12rpx 18rpx; background: transparent; color: var(--cp-muted); font-size: 23rpx; }
.filter-scroll { width: 100%; margin-bottom: 12rpx; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 10rpx; padding: 2rpx 0 6rpx; }
.filter-chip { min-height: 68rpx; padding: 12rpx 25rpx; border-radius: 20rpx; border: 1rpx solid transparent; background: var(--cp-tint); color: var(--cp-muted); font-size: 24rpx; font-weight: 550; }
.filter-chip.active { background: var(--cp-accent); color: #fff; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 4rpx 18rpx; color: var(--cp-ink); font-size: 27rpx; font-weight: 600; }
.section-head > text:last-child { font-size: 22rpx; font-weight: 400; color: var(--cp-muted); }

.account-card, .vault-card { padding: 28rpx; border-color: var(--cp-border); background: linear-gradient(150deg, var(--cp-surface) 60%, var(--cp-tint)); }
.card-hover { opacity: .8; }
.card-main { display: flex; align-items: flex-start; gap: 18rpx; }
.card-info { min-width: 0; flex: 1; }
.kind-badge { display: inline-block; padding: 6rpx 13rpx; border-radius: 10rpx; background: var(--cp-tint); color: var(--cp-accent); font-size: 20rpx; font-weight: 600; }
.kind-badge.secret { background: #F4E7EB; color: #8D596A; }
.kind-badge.code { background: #F6ECD8; color: #84632F; }
.kind-badge.note { background: #E9E8F4; color: #696080; }
.item-title, .item-subtitle, .item-identifier { display: block; }
.item-title { margin-top: 16rpx; color: var(--cp-ink); font-size: 31rpx; font-weight: 650; line-height: 1.4; word-break: break-all; }
.item-subtitle { margin-top: 7rpx; overflow: hidden; color: var(--cp-muted); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.item-identifier { margin-top: 6rpx; color: var(--cp-muted); font-size: 22rpx; word-break: break-all; }
.card-actions { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--cp-border); }
.totp-area { min-width: 0; flex: 1; }
.totp-code, .totp-time { display: block; }
.totp-code { color: var(--cp-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 40rpx; font-weight: 650; line-height: 1.15; font-variant-numeric: tabular-nums; }
.totp-code.revealed { color: var(--cp-accent); }
.totp-time { margin-top: 9rpx; color: var(--cp-muted); font-size: 20rpx; }
.code-tools { display: flex; flex: none; align-items: center; gap: 10rpx; }
.mini-action { min-height: 68rpx; padding: 12rpx 22rpx; border: 1rpx solid var(--cp-border); border-radius: 18rpx; background: var(--cp-surface); color: var(--cp-accent); font-size: 23rpx; }
.mini-action.primary { border-color: transparent; background: var(--cp-accent); color: #fff; }
.account-card progress { margin-top: 22rpx; border-radius: 999rpx; overflow: hidden; }
.vault-top, .vault-meta { display: flex; align-items: center; gap: 16rpx; }
.vault-top { justify-content: space-between; }
.expiry { color: var(--cp-muted); font-size: 21rpx; }
.vault-meta { flex-wrap: wrap; margin-top: 24rpx; color: var(--cp-muted); font-size: 21rpx; }
.vault-meta text:last-child { margin-left: auto; color: var(--cp-accent); }

.offline-bar { margin: -22rpx -32rpx 22rpx; padding: 16rpx 28rpx; background: #F7ECD5; color: #7A5E2D; font-size: 23rpx; text-align: center; }
.platform-notice { margin-bottom: 22rpx; padding: 22rpx 26rpx; border: 1rpx solid var(--cp-border); border-radius: 22rpx; background: var(--cp-tint); color: var(--cp-ink); }
.platform-notice.maintenance { border-color: #E4D1A5; background: #FCF4E3; color: #765820; }
.notice-label, .notice-content { display: block; }
.notice-label { font-size: 23rpx; font-weight: 650; }
.notice-content { margin-top: 8rpx; font-size: 23rpx; line-height: 1.55; }
.login-card { margin-top: 5vh; padding: 48rpx 32rpx; text-align: center; background: linear-gradient(150deg, var(--cp-surface), var(--cp-tint)); }
.brand-mark { width: 100rpx; height: 100rpx; margin: 0 auto 28rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--cp-border); border-radius: 28rpx; background: var(--cp-tint); color: var(--cp-accent); font-family: Georgia, serif; font-size: 36rpx; font-weight: 600; }
.login-title { font-size: 40rpx; font-weight: 650; }
.login-desc { margin: 16rpx auto 32rpx; max-width: 560rpx; color: var(--cp-muted); font-size: 25rpx; line-height: 1.65; }
.avatar-picker { width: 190rpx; margin: 0 auto 24rpx; }
.avatar-button { width: 180rpx; margin: 0 auto; padding: 0; display: flex; flex-direction: column; gap: 8rpx; background: transparent; color: var(--cp-muted); font-size: 22rpx; }
.avatar-alternate { width: 100%; min-height: 46rpx; margin-top: 4rpx; padding: 4rpx; background: transparent; color: var(--cp-accent); font-size: 19rpx; }
.login-avatar { width: 112rpx; height: 112rpx; border: 4rpx solid var(--cp-surface); border-radius: 50%; }
.nickname-input { margin-bottom: 20rpx; text-align: center; }
.login-button { width: 100%; }
.consent-row { margin: 20rpx 0; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6rpx; color: var(--cp-muted); font-size: 22rpx; }
.consent-row label { display: flex; align-items: center; }
.consent-row checkbox { transform: scale(.72); }
.legal-link { color: var(--cp-accent); }
.login-context { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--cp-border); color: var(--cp-muted); font-size: 21rpx; line-height: 1.6; }
.login-context text { display: block; }
.login-context text + text { margin-top: 6rpx; }

@media (max-width: 350px) {
  .home-masthead { gap: 12rpx; }
  .masthead-note { font-size: 20rpx; }
  .team-picker { flex-wrap: wrap; }
  .team-picker > view { flex-basis: 70%; }
  .picker-arrow { margin-left: auto; }
  .code-tools { gap: 8rpx; }
  .mini-action { padding: 12rpx 17rpx; }
  .totp-code { font-size: 36rpx; }
}
