.page {
  padding: 16px;
}

.header .title {
  font-size: 20px;
  font-weight: 700;
  color: #1f2933;
}

.header .subtitle {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  color: #6b7280;
}

.team-picker {
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.team-picker .label {
  color: #6b7280;
  font-size: 14px;
}

.picker-value {
  color: #2979ff;
}

.search-box {
  margin-top: 12px;
  background: #f1f5f9;
  border-radius: 12px;
  padding: 8px 12px;
}

.search-box input {
  width: 100%;
}

.content {
  margin-top: 16px;
  padding-bottom: 140px;
}

.section-label {
  margin: 20px 4px 10px;
  color: #64748b;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1px;
}

.account-card {
  transition: transform 0.2s;
}

.account-card:active {
  transform: scale(0.99);
}

.account-card .issuer {
  font-size: 16px;
  font-weight: 600;
}

.account-card .label {
  font-size: 14px;
  color: #6b7280;
}

.account-card .identifier {
  margin-top: 4px;
  font-size: 12px;
  color: #94a3b8;
}

.account-card .note {
  margin-top: 2px;
  font-size: 12px;
  color: #2563eb;
}

.account-card .code {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #16a34a;
}

.item-card { border-left: 4px solid #16a34a; }
.item-card:active { transform: scale(0.99); }
.item-type { color: #16a34a; font-size: 11px; font-weight: 600; }
.item-title { margin-top: 8px; color: #172033; font-size: 17px; font-weight: 700; }
.item-meta { display: flex; gap: 12px; margin-top: 12px; color: #94a3b8; font-size: 11px; }
.item-meta text:last-child { margin-left: auto; }

.meta {
  margin-top: 12px;
  display: flex;
  align-items: center;
}

.meta .tag {
  margin-right: 8px;
}

.progress {
  margin-top: 8px;
}

.empty {
  text-align: center;
  color: #9ca3af;
}

.skeleton {
  text-align: center;
  color: #9ca3af;
}

.login-card {
  text-align: center;
  margin-top: 24px;
}

.login-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 8px;
}

.login-desc {
  color: #6b7280;
  margin-bottom: 16px;
}

.profile-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.profile-preview .avatar {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: #f1f5f9;
}

.profile-preview .nickname {
  font-size: 16px;
  font-weight: 600;
  color: #1f2933;
}

.fab-container {
  position: fixed;
  right: 24px;
  bottom: 40px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fab {
  background: linear-gradient(135deg, #15803d, #16a34a);
  color: #fff;
  border-radius: 24px;
  padding: 12px 20px;
  font-weight: 600;
  box-shadow: 0 12px 24px rgba(22, 163, 74, 0.2);
}

.fab.secondary {
  background: #ffffff;
  color: #15803d;
  border: 1px solid #16a34a;
}

.fab.scan { background: #101820; padding: 10px 16px; align-self: flex-end; }
