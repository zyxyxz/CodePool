.offline-bar {
  margin: -28rpx -28rpx 20rpx;
  padding: 16rpx;
  background: #fff4dc;
  color: #7a4d00;
  text-align: center;
  font-size: 23rpx;
}

.totp-card {
  padding: 34rpx;
  border-radius: 16rpx;
  background: #101820;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(16, 24, 32, 0.14);
}

.service-row,
.code-actions,
.share-actions {
  display: flex;
  align-items: center;
}

.service-row {
  justify-content: space-between;
  gap: 20rpx;
}

.service-heading { flex: 1; min-width: 0; word-break: break-all; }
.card-tools { display: flex; align-items: center; gap: 12rpx; flex: none; }
.more-button { width: 68rpx; height: 68rpx; min-height: 68rpx; padding: 0; border-radius: 12rpx; background: #25352c; color: #fff; font-size: 36rpx; }

.service,
.label,
.code,
.code-hint,
.share-title,
.share-desc,
.share-status,
.share-time {
  display: block;
}

.service {
  font-size: 36rpx;
  font-weight: 730;
}

.label {
  margin-top: 8rpx;
  color: #aeb9b2;
  font-size: 24rpx;
}

.security-badge {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #25352c;
  color: #7ce79d;
  font-size: 20rpx;
  font-weight: 750;
}

.code-wrap {
  margin: 62rpx 0 34rpx;
  text-align: center;
}

.code {
  color: #7c8a82;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.code.visible {
  color: #7ce79d;
}

.code-hint {
  margin-top: 18rpx;
  color: #9eaaa3;
  font-size: 22rpx;
}

.code-actions {
  margin-top: 28rpx;
  gap: 14rpx;
}

.reveal-button,
.copy-button {
  flex: 1;
  border-radius: 18rpx;
}

.reveal-button {
  background: #2a3a31;
  color: #8ff0ab;
}

.copy-button {
  background: #15803d;
  color: #ffffff;
}

.info-card {
  margin-top: 22rpx;
}

.info-row {
  padding: 20rpx 0;
  display: flex;
  justify-content: space-between;
  gap: 28rpx;
  border-top: 1rpx solid #edf1ee;
  color: #718078;
  font-size: 24rpx;
}

.info-row text:last-child {
  max-width: 68%;
  color: #26342c;
  text-align: right;
  word-break: break-all;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.action-grid button:only-child {
  grid-column: 1 / -1;
}

.share-ready {
  margin-top: 22rpx;
  border-color: #b7ddc1;
  background: #f0f9f2;
}

.share-title {
  font-size: 29rpx;
  font-weight: 680;
}

.share-desc {
  margin-top: 8rpx;
  color: #5f6f65;
  font-size: 22rpx;
}

.share-actions {
  margin-top: 20rpx;
  gap: 12rpx;
}

.shares-card {
  margin-top: 22rpx;
}

.section-title {
  margin-bottom: 0;
}

.small {
  font-size: 22rpx;
}

.empty-shares {
  padding: 22rpx 0 8rpx;
  color: #89958e;
  font-size: 24rpx;
  text-align: center;
}

.share-row {
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid #edf1ee;
}

.share-status {
  color: #718078;
  font-size: 24rpx;
  font-weight: 650;
}

.share-status.active {
  color: #15803d;
}

.share-time,
.share-views {
  margin-top: 5rpx;
  color: #89958e;
  font-size: 21rpx;
}

.share-side { display: flex; align-items: center; gap: 12rpx; }
.revoke-share { min-height: 60rpx; padding: 10rpx 16rpx; border-radius: 14rpx; background: #fff1f0; color: #b42318; font-size: 21rpx; }

.safe-note {
  margin-top: 22rpx;
}

.sheet-mask { position: fixed; inset: 0; z-index: 100; background: rgba(10, 20, 14, .48); display: flex; align-items: flex-end; }
.transfer-sheet { width: 100%; max-height: 86vh; overflow-y: auto; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: #fff; }
.sheet-header { display: flex; justify-content: space-between; align-items: center; }
.sheet-close { width: 68rpx; min-height: 68rpx; padding: 0; background: #f0f4f1; border-radius: 12rpx; font-size: 36rpx; }
.transfer-desc, .transfer-note { display: block; color: #718078; font-size: 24rpx; line-height: 1.6; margin: 18rpx 0; }
.transfer-search { margin: 20rpx 0; }
.transfer-list { max-height: 38vh; }
.transfer-team { width: 100%; display: flex; justify-content: space-between; text-align: left; padding: 22rpx; margin: 12rpx 0; border-radius: 12rpx; border: 2rpx solid #e3ebe6; background: #f8faf9; }
.transfer-team.selected { border-color: #15803d; background: #edf8f0; }
.transfer-team > view { flex: 1; min-width: 0; }
.transfer-team-name { display: block; font-size: 28rpx; font-weight: 650; word-break: break-all; }
.transfer-team-meta { display: block; color: #718078; margin-top: 8rpx; font-size: 22rpx; }
.transfer-check { flex: none; margin-left: 20rpx; color: #15803d; }
.transfer-state { padding: 32rpx 0; font-size: 26rpx; line-height: 1.7; color: #718078; }
.transfer-error { padding: 22rpx; background: #fff1f0; border-radius: 12rpx; color: #b42318; font-size: 24rpx; line-height: 1.6; }
