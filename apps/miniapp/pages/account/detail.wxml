<view class="page">
  <view class="offline-bar" wx:if="{{offline}}">当前网络不可用</view>

  <view class="card state-card" wx:if="{{loading}}">
    <text class="state-symbol">···</text>
    <text class="state-title">正在校验访问权限</text>
    <text class="state-desc">动态码仅在你主动显示时生成。</text>
  </view>

  <view class="card state-card" wx:elif="{{error}}">
    <text class="state-symbol">!</text>
    <text class="state-title">无法查看动态码</text>
    <text class="state-desc">{{error}}</text>
    <button class="button-secondary" bindtap="handleRetry">重新加载</button>
  </view>

  <block wx:elif="{{account}}">
    <view class="totp-card">
      <view class="service-row">
        <view class="service-heading">
          <text class="service">{{account.issuer}}</text>
          <text class="label">{{account.label}}</text>
        </view>
        <view class="card-tools">
          <text class="security-badge">TOTP</text>
          <button class="more-button" wx:if="{{account.canManage}}" bindtap="handleMore" disabled="{{transferring || deleting || sharing}}" aria-label="更多操作">···</button>
        </view>
      </view>

      <view class="code-wrap">
        <text class="code {{codeVisible ? 'visible' : ''}}">{{codeDisplay}}</text>
        <text class="code-hint">{{codeVisible ? expiresIn + ' 秒后自动更新' : '点击后按需生成，不会自动批量读取'}}</text>
      </view>

      <progress wx:if="{{codeVisible}}" percent="{{progress}}" stroke-width="4" activeColor="#7CE79D" backgroundColor="#34443A" />
      <view class="code-actions">
        <button class="reveal-button" loading="{{codeLoading}}" disabled="{{transferring || deleting}}" bindtap="handleToggleCode">{{codeVisible ? '立即隐藏' : '显示动态码'}}</button>
        <button class="copy-button" disabled="{{transferring || deleting}}" bindtap="handleCopy">复制动态码</button>
      </view>
    </view>

    <view class="card info-card">
      <text class="section-title">账号信息</text>
      <view class="info-row"><text>所属团队</text><text>{{account.teamName}}</text></view>
      <view class="info-row"><text>登录账号</text><text selectable="true">{{account.accountIdentifier || '未填写'}}</text></view>
      <view class="info-row"><text>团队备注</text><text>{{account.remark || '未填写'}}</text></view>
      <view class="info-row"><text>算法配置</text><text>{{account.algorithm}} · {{account.digits}} 位 · {{account.period}} 秒</text></view>
      <view class="info-row"><text>最近更新</text><text>{{account.updatedText}}</text></view>
    </view>

    <view class="action-grid">
      <button class="button-secondary" wx:if="{{account.canManage}}" bindtap="handleEdit">编辑信息</button>
      <button class="button-secondary" wx:if="{{account.canShare}}" loading="{{sharing}}" bindtap="handleCreateShare">创建一次性分享</button>
    </view>

    <view class="card share-ready" wx:if="{{shareToken}}">
      <text class="share-title">一次性分享已就绪</text>
      <text class="share-desc">有效期至 {{shareExpiresText}}，仅可领取一次。</text>
      <view class="share-actions">
        <button class="button-primary button-small" open-type="share">微信转发</button>
        <button class="button-ghost button-small" bindtap="handleCopyShareToken">复制口令</button>
      </view>
    </view>

    <view class="card shares-card">
      <view class="flex-between">
        <text class="section-title">最近分享</text>
        <text class="muted small">{{sharesLoading ? '同步中' : shares.length + ' 条'}}</text>
      </view>
      <view class="empty-shares" wx:if="{{!sharesLoading && !shares.length}}">还没有创建过分享</view>
      <block wx:for="{{shares}}" wx:key="id">
        <view class="share-row">
          <view><text class="share-status {{item.active ? 'active' : ''}}">{{item.statusText}}</text><text class="share-time">有效至 {{item.expiresText}}</text></view>
          <view class="share-side"><text class="share-views">领取 {{item.viewsText}}</text><button wx:if="{{item.active && item.canRevoke}}" class="revoke-share" data-id="{{item.id}}" bindtap="handleRevokeShare">撤销</button></view>
        </view>
      </block>
    </view>

    <view class="safe-note">动态码会在 60 秒后自动遮挡，切换后台也会立即清除。请勿截图或转发包含验证码的页面。</view>
  </block>

  <view class="sheet-mask" wx:if="{{transferOpen}}" bindtap="closeTransfer" catchtouchmove="stopPropagation">
    <view class="transfer-sheet" catchtap="stopPropagation" role="dialog" aria-label="转移到其他团队">
      <view class="sheet-header"><text class="section-title">转移到其他团队</text><button class="sheet-close" bindtap="closeTransfer" disabled="{{transferring}}" aria-label="关闭">×</button></view>
      <text class="transfer-desc">选择你有管理权限的目标团队。转移后，原团队将无法访问此动态验证码。</text>
      <input wx:if="{{transferTeams.length}}" class="input transfer-search" value="{{transferQuery}}" bindinput="handleTransferSearch" disabled="{{transferring}}" maxlength="48" placeholder="搜索目标团队" />
      <view wx:if="{{transferLoading}}" class="transfer-state">正在加载可转入的团队…</view>
      <view wx:elif="{{transferError}}" class="transfer-error" role="alert"><text>{{transferError}}</text><button wx:if="{{!transferTeams.length}}" class="button-ghost button-small" bindtap="loadTransferTeams">重新加载</button></view>
      <view wx:elif="{{!transferTeams.length}}" class="transfer-state">暂无其他可转入的团队。请先创建团队，或请目标团队所有者将你设为管理员。</view>
      <scroll-view class="transfer-list" scroll-y="true" wx:if="{{!transferLoading && transferTeams.length}}">
        <button wx:for="{{visibleTransferTeams}}" wx:key="teamId" class="transfer-team {{targetTeamId === item.teamId ? 'selected' : ''}}" data-id="{{item.teamId}}" bindtap="handleTransferSelect" disabled="{{transferring}}" aria-label="{{item.name}}">
          <view><text class="transfer-team-name">{{item.name}}</text><text class="transfer-team-meta">{{item.memberCount}} 位成员 · {{item.role === 'owner' ? '所有者' : '管理员'}}</text></view><text class="transfer-check">{{targetTeamId === item.teamId ? '✓' : '○'}}</text>
        </button>
        <view wx:if="{{!visibleTransferTeams.length}}" class="transfer-state">没有匹配的团队</view>
      </scroll-view>
      <text class="transfer-note">已有分享将在转移后撤销；动态码生成规则不变。</text>
      <button class="button-primary" bindtap="confirmTransfer" loading="{{transferring}}" disabled="{{transferLoading || transferring || !targetTeamId}}">{{transferring ? '正在转移' : '转移到所选团队'}}</button>
    </view>
  </view>
</view>
