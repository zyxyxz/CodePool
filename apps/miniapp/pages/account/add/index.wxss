.intro {
  padding: 12rpx 8rpx 34rpx;
  border-bottom: 1rpx solid var(--cp-border);
}

.intro text {
  display: block;
}

.eyebrow {
  color: var(--cp-accent);
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 0;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 650;
}

.desc {
  margin-top: 14rpx;
  color: var(--cp-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.scan-button {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 26rpx;
  justify-content: flex-start;
  gap: 20rpx;
  border: 1rpx solid var(--cp-border);
  border-radius: 20rpx;
  background: var(--cp-tint);
  color: var(--cp-ink);
  text-align: left;
}

.scan-mark {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--cp-accent);
  color: #ffffff;
  font-size: 34rpx;
}

.scan-title,
.scan-desc {
  display: block;
}

.scan-title {
  font-size: 28rpx;
  font-weight: 680;
}

.scan-desc {
  margin-top: 6rpx;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.scan-arrow {
  margin-left: auto;
  color: var(--cp-accent);
  font-size: 40rpx;
}

.form-card {
  padding-bottom: 2rpx;
}

.field {
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid var(--cp-border);
}

.field + .field {
  padding-top: 26rpx;
}

.picker-value,
.field-heading,
.inline-actions {
  display: flex;
  align-items: center;
}

.picker-value,
.field-heading {
  justify-content: space-between;
}

.picker-value text:last-child {
  color: var(--cp-muted);
  font-size: 23rpx;
}

.picker-value.disabled {
  background: var(--cp-tint);
  color: var(--cp-muted);
}

.remark-input {
  min-height: 150rpx;
}

.inline-actions {
  gap: 8rpx;
}

.inline-actions button {
  min-height: 58rpx;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: var(--cp-tint);
  color: var(--cp-accent);
  font-size: 21rpx;
}

.secret-input {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 0;
}

.field-help {
  display: block;
  margin-top: 12rpx;
  color: var(--cp-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.config-grid {
  padding-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.field.compact {
  padding: 0;
  border: 0;
}

.field.compact .picker-value {
  padding: 18rpx 10rpx;
  justify-content: center;
  text-align: center;
}

.immutable-note {
  margin: 26rpx 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff7e6;
  color: #765000;
  font-size: 22rpx;
  line-height: 1.6;
}

.safe-note {
  margin-top: 20rpx;
}

.submit {
  width: 100%;
  margin-top: 24rpx;
}
