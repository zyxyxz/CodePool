.page {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.intro {
  padding: 12rpx 8rpx 34rpx;
}

.intro text {
  display: block;
}

.eyebrow {
  color: var(--cp-accent);
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 0;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 650;
}

.desc {
  margin-top: 14rpx;
  color: var(--cp-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.form-card {
  padding-bottom: 4rpx;
}

.intro {
  border-bottom: 1rpx solid var(--cp-border);
}

.field {
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid var(--cp-border);
}

.field + .field {
  padding-top: 26rpx;
}

.field:last-child {
  border-bottom: 0;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value text:last-child {
  color: var(--cp-muted);
  font-size: 23rpx;
}

.picker-value.disabled {
  background: var(--cp-tint);
  color: var(--cp-muted);
}

.field-help {
  display: block;
  margin-top: 12rpx;
  color: var(--cp-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.field-heading,
.content-foot,
.mask-switch {
  display: flex;
  align-items: center;
}

.field-heading {
  justify-content: space-between;
}

.paste-button {
  min-height: 60rpx;
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  background: var(--cp-tint);
  color: var(--cp-accent);
  font-size: 22rpx;
}

.content-input {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.secret-content-input {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 0;
}

.content-foot {
  min-height: 60rpx;
  margin-top: 12rpx;
  justify-content: space-between;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.mask-switch {
  gap: 10rpx;
}

.mask-switch switch {
  transform: scale(0.72);
  transform-origin: left center;
  margin-right: -18rpx;
}

.counter {
  margin-left: auto;
}

.safe-note {
  margin-top: 20rpx;
}

.submit {
  width: 100%;
  margin-top: 24rpx;
}
