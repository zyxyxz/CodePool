<view class="page">
  <view class="intro">
    <text class="eyebrow">{{editing ? 'EDIT SECURE ITEM' : 'NEW SECURE ITEM'}}</text>
    <text class="title">{{editing ? '编辑共享内容' : '放入团队代码池'}}</text>
    <text class="desc">正文会加密保存。开始前确认团队、成员范围和内容有效期。</text>
  </view>

  <view class="card state-card" wx:if="{{loading}}">
    <text class="state-symbol">···</text>
    <text class="state-title">正在准备安全表单</text>
  </view>

  <view class="card state-card" wx:elif="{{error}}">
    <text class="state-symbol">!</text>
    <text class="state-title">无法打开表单</text>
    <text class="state-desc">{{error}}</text>
    <button class="button-secondary" bindtap="handleRetry">重新加载</button>
  </view>

  <block wx:else>
    <view class="card form-card">
      <view class="field">
        <text class="field-label">内容类型</text>
        <picker disabled="{{editing}}" range="{{kinds}}" range-key="label" value="{{kindIndex}}" bindchange="handleKindChange">
          <view class="picker-value {{editing ? 'disabled' : ''}}"><text>{{kinds[kindIndex].label}}</text><text>{{editing ? '不可修改' : '选择 ›'}}</text></view>
        </picker>
        <text class="field-help">{{kinds[kindIndex].help}}</text>
      </view>

      <view class="field">
        <text class="field-label">所属团队</text>
        <picker disabled="{{editing}}" range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="handleTeamChange">
          <view class="picker-value {{editing ? 'disabled' : ''}}"><text>{{teams[teamIndex] ? teams[teamIndex].name : '请选择团队'}}</text><text>{{editing ? '不可修改' : '选择 ›'}}</text></view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">标题 *</text>
        <input class="input" maxlength="120" placeholder="例如：生产环境发布脚本" data-field="title" value="{{form.title}}" bindinput="handleInput" />
      </view>

      <view class="field">
        <text class="field-label">标识（可选）</text>
        <input class="input" maxlength="160" placeholder="项目、环境或账号，便于搜索" data-field="identifier" value="{{form.identifier}}" bindinput="handleInput" />
      </view>

      <view class="field" wx:if="{{kinds[kindIndex].value === 'snippet'}}">
        <text class="field-label">代码语言（可选）</text>
        <input class="input" maxlength="40" placeholder="shell / sql / javascript" data-field="language" value="{{form.language}}" bindinput="handleInput" />
      </view>

      <view class="field">
        <text class="field-label">自动过期</text>
        <picker range="{{expirations}}" range-key="label" value="{{expirationIndex}}" bindchange="handleExpirationChange">
          <view class="picker-value"><text>{{expirations[expirationIndex].label}}</text><text>选择 ›</text></view>
        </picker>
        <text class="field-help">到期后内容会从成员列表中自动隐藏，无法通过普通搜索找到。</text>
      </view>

      <view class="field content-field">
        <view class="field-heading">
          <text class="field-label">内容 *</text>
          <button class="paste-button" bindtap="handlePaste">粘贴</button>
        </view>
        <input wx:if="{{kinds[kindIndex].value === 'secret' && maskContent}}" class="input secret-content-input" password maxlength="200000" placeholder="输入或粘贴敏感内容…" data-field="content" value="{{form.content}}" bindinput="handleInput" />
        <textarea wx:else class="textarea content-input" maxlength="200000" placeholder="粘贴代码、口令或团队说明…" data-field="content" value="{{form.content}}" bindinput="handleInput" />
        <view class="content-foot">
          <view class="mask-switch" wx:if="{{kinds[kindIndex].value === 'secret'}}">
            <switch color="#15803D" checked="{{maskContent}}" bindchange="handleMaskChange" />
            <text>输入时遮挡</text>
          </view>
          <text class="counter">{{contentLength}} / 200000</text>
        </view>
      </view>
    </view>

    <view class="safe-note">保存后，查看、编辑、复制和分享会记录到团队审计中；审计不包含正文。</view>
    <button class="button-primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleSubmit">{{editing ? '保存修改' : '保存到代码池'}}</button>
  </block>
</view>
