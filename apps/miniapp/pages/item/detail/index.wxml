<view class="page">
  <view class="offline-bar" wx:if="{{offline}}">当前网络不可用</view>

  <view class="card state-card" wx:if="{{loading}}">
    <text class="state-symbol">···</text>
    <text class="state-title">正在校验访问权限</text>
    <text class="state-desc">先同步必要元数据；正文仅在你主动显示后读取。</text>
  </view>

  <view class="card state-card" wx:elif="{{error}}">
    <text class="state-symbol">!</text>
    <text class="state-title">无法查看内容</text>
    <text class="state-desc">{{error}}</text>
    <button class="button-secondary" bindtap="handleRetry">重新加载</button>
  </view>

  <block wx:elif="{{item}}">
    <view class="meta-card">
      <view class="meta-top">
        <text class="kind {{item.kind}}">{{item.kindLabel}}</text>
        <text class="expiry {{item.expired ? 'expired' : ''}}">{{item.expiresAt ? '有效至 ' + item.expiresText : '长期有效'}}</text>
      </view>
      <text class="title">{{item.title}}</text>
      <text class="identifier" wx:if="{{item.identifier}}">{{item.identifier}}</text>
      <view class="meta-list">
        <text wx:if="{{item.language}}">语言：{{item.language}}</text>
        <text>更新：{{item.updatedText}}</text>
      </view>
    </view>

    <view class="content-card {{contentVisible ? 'visible' : 'masked'}}">
      <view class="content-head">
        <text>加密正文</text>
        <text>{{contentVisible ? '60 秒后自动遮挡' : '默认遮挡'}}</text>
      </view>
      <text class="content-text" selectable="{{contentVisible}}">{{displayContent}}</text>
      <button class="reveal-button" bindtap="handleToggleContent">{{contentVisible ? '立即隐藏' : '显示内容'}}</button>
    </view>

    <view class="action-grid">
      <button class="button-primary" bindtap="handleCopy">复制到剪贴板</button>
      <button class="button-secondary" wx:if="{{item.canEdit}}" bindtap="handleEdit">编辑内容</button>
      <button class="button-secondary" wx:if="{{item.canEdit}}" bindtap="handleDuplicate">复制为新条目</button>
      <button class="button-secondary" wx:if="{{item.canShare}}" loading="{{sharing}}" bindtap="handleCreateShare">创建一次性分享</button>
    </view>

    <view class="card share-ready" wx:if="{{shareToken}}">
      <view>
        <text class="share-title">一次性分享已就绪</text>
        <text class="share-desc">有效期至 {{shareExpiresText}}。转发卡片不会包含正文。</text>
      </view>
      <view class="share-actions">
        <button class="button-primary button-small" open-type="share">微信转发</button>
        <button class="button-ghost button-small" bindtap="handleCopyShareToken">复制口令</button>
      </view>
    </view>

    <view class="card shares-card">
      <view class="flex-between">
        <text class="section-title">最近分享</text>
        <text class="muted small">{{sharesLoading ? '同步中' : shares.length + ' 条'}}</text>
      </view>
      <view class="empty-shares" wx:if="{{!sharesLoading && !shares.length}}">还没有创建过分享</view>
      <block wx:for="{{shares}}" wx:key="id">
        <view class="share-row">
          <view>
            <text class="share-status {{item.active ? 'active' : ''}}">{{item.statusText}}</text>
            <text class="share-time">有效至 {{item.expiresText}}</text>
          </view>
          <view class="share-side"><text class="share-views">领取 {{item.viewsText}}</text><button wx:if="{{item.active && item.canRevoke}}" class="revoke-share" data-id="{{item.id}}" bindtap="handleRevokeShare">撤销</button></view>
        </view>
      </block>
    </view>

    <button class="button-danger delete-button" wx:if="{{item.canDelete}}" bindtap="handleDelete">永久删除内容</button>
    <view class="safe-note">查看、编辑、复制与分享会产生必要审计记录；记录不包含正文。</view>
  </block>
</view>
