.offline-bar {
  margin: -32rpx -32rpx 24rpx;
  padding: 16rpx;
  background: #fff4dc;
  color: #7a4d00;
  text-align: center;
  font-size: 23rpx;
}

.meta-card,
.content-card {
  border-radius: 28rpx;
  padding: 32rpx;
}

.meta-card {
  background: var(--cp-surface);
  border: 1rpx solid var(--cp-border);
}

.meta-top,
.meta-list,
.content-head,
.share-actions {
  display: flex;
  align-items: center;
}

.meta-top,
.content-head {
  justify-content: space-between;
  gap: 20rpx;
}

.kind {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: var(--cp-tint);
  color: var(--cp-accent);
  font-size: 20rpx;
  font-weight: 650;
}

.kind.secret {
  background: #fff1f0;
  color: #a92920;
}

.kind.code {
  background: #fff6dd;
  color: #805400;
}

.kind.note {
  background: #eef3ff;
  color: #31599a;
}

.expiry {
  color: var(--cp-muted);
  font-size: 22rpx;
}

.expiry.expired {
  color: #b42318;
}

.title,
.identifier {
  display: block;
}

.title {
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.35;
}

.identifier {
  margin-top: 10rpx;
  color: var(--cp-muted);
  font-size: 25rpx;
}

.meta-list {
  margin-top: 24rpx;
  flex-wrap: wrap;
  gap: 18rpx;
  color: var(--cp-muted);
  font-size: 22rpx;
}

.content-card {
  min-height: 360rpx;
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end));
  border: 1rpx solid var(--cp-border);
  color: var(--cp-ink);
}

.content-card.masked {
  background: var(--cp-tint);
}

.content-head {
  color: var(--cp-muted);
  font-size: 21rpx;
}

.content-text {
  min-height: 190rpx;
  margin: 30rpx 0;
  flex: 1;
  color: var(--cp-ink);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.content-card.masked .content-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cp-muted);
  text-align: center;
}

.reveal-button {
  width: 100%;
  border: 1rpx solid var(--cp-border);
  background: rgba(255, 253, 250, .72);
  color: var(--cp-accent);
  border-radius: 22rpx;
}

.action-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.action-grid button:only-child {
  grid-column: 1 / -1;
}

.share-ready {
  margin-top: 22rpx;
  border-color: var(--cp-border);
  background: var(--cp-tint);
}

.share-title,
.share-desc,
.share-status,
.share-time {
  display: block;
}

.share-title {
  font-size: 29rpx;
  font-weight: 680;
}

.share-desc {
  margin-top: 8rpx;
  color: var(--cp-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.share-actions {
  margin-top: 20rpx;
  gap: 12rpx;
}

.shares-card {
  margin-top: 22rpx;
}

.section-title {
  margin-bottom: 0;
}

.small {
  font-size: 22rpx;
}

.empty-shares {
  padding: 22rpx 0 8rpx;
  color: var(--cp-muted);
  font-size: 24rpx;
  text-align: center;
}

.share-row {
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--cp-border);
}

.share-status {
  color: var(--cp-muted);
  font-size: 24rpx;
  font-weight: 650;
}

.share-status.active {
  color: var(--cp-accent);
}

.share-time,
.share-views {
  margin-top: 5rpx;
  color: var(--cp-muted);
  font-size: 21rpx;
}

.share-side { display: flex; align-items: center; gap: 12rpx; }
.revoke-share { min-height: 60rpx; padding: 10rpx 16rpx; border-radius: 20rpx; background: #fff1f0; color: #b42318; font-size: 21rpx; }

.delete-button {
  width: 100%;
  margin-top: 12rpx;
}

.safe-note {
  margin-top: 22rpx;
}
