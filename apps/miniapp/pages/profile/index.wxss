.profile-header { padding: 8rpx 4rpx 30rpx; }
.profile-header text,.login-title,.login-desc,.menu-title,.menu-desc,.user-id,.joined { display: block; }
.eyebrow { color: var(--cp-accent); font-size: 20rpx; font-weight: 650; letter-spacing: 0; }
.page-title { margin-top: 10rpx; font-size: 42rpx; font-weight: 650; }
.page-desc { margin-top: 8rpx; color: var(--cp-muted); font-size: 23rpx; }
.login-card { padding: 44rpx 36rpx; text-align: center; }
.login-title { font-size: 36rpx; font-weight: 650; }
.login-desc { margin: 14rpx auto 28rpx; color: var(--cp-muted); font-size: 24rpx; line-height: 1.6; }
.avatar-picker { width: 190rpx; margin: 0 auto 20rpx; }
.avatar-button { width: 180rpx; margin: 0 auto; padding: 0; display: flex; flex-direction: column; gap: 8rpx; background: transparent; color: var(--cp-muted); font-size: 22rpx; }
.avatar-button image { width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--cp-tint); }
.avatar-alternate { width: 100%; min-height: 46rpx; margin-top: 4rpx; padding: 4rpx; background: transparent; color: var(--cp-accent); font-size: 19rpx; }
.nickname-input { margin-bottom: 18rpx; text-align: center; }
.consent-row { margin: 18rpx 0; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6rpx; color: var(--cp-muted); font-size: 22rpx; }
.consent-row label { display: flex; align-items: center; }
.consent-row checkbox { transform: scale(.72); }
.legal-link { color: var(--cp-accent); }
.account-card { padding: 30rpx; border: 1rpx solid var(--cp-border); border-radius: 32rpx; background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-ink); box-shadow: 0 12rpx 36rpx rgba(62, 52, 42, .045); }
.account-caption { display: flex; justify-content: space-between; align-items: center; color: var(--cp-accent); font-size: 18rpx; font-weight: 600; }
.account-status { padding: 6rpx 14rpx; border: 1rpx solid rgba(141, 119, 82, .2); border-radius: 999rpx; color: #786344; background: rgba(255, 253, 250, .55); font-size: 19rpx; font-weight: 400; }
.account-main { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; }
.signed-picker { width: 112rpx; margin: 0; flex: none; }
.avatar-button.signed { width: 96rpx; margin: 0 auto; color: var(--cp-muted); font-size: 18rpx; }
.avatar-button.signed image { width: 88rpx; height: 88rpx; border: 4rpx solid var(--cp-surface); box-shadow: 0 4rpx 16rpx rgba(62, 52, 42, .08); }
.signed-picker .avatar-alternate { color: var(--cp-accent); font-size: 18rpx; }
.account-info { min-width: 0; flex: 1; }
.nickname-edit { height: 58rpx; padding-bottom: 5rpx; border-bottom: 1rpx solid var(--cp-border); color: var(--cp-ink); font-size: 32rpx; font-weight: 600; }
.user-id,.joined { margin-top: 6rpx; overflow: hidden; color: var(--cp-muted); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.save-profile { flex: none; min-height: 68rpx; padding: 12rpx 18rpx; border: 1rpx solid var(--cp-border); border-radius: 18rpx; background: rgba(255, 253, 250, .72); color: var(--cp-accent); font-size: 22rpx; }
.section-label { margin: 34rpx 8rpx 14rpx; color: var(--cp-muted); font-size: 23rpx; font-weight: 650; }
.menu-card { padding-top: 0; padding-bottom: 0; }
.menu-row { min-height: 116rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--cp-border); }
.menu-row:last-child { border-bottom: 0; }
.menu-row.tap:active { opacity: .6; }
.menu-title { font-size: 27rpx; font-weight: 630; }
.menu-desc { max-width: 520rpx; margin-top: 5rpx; overflow: hidden; color: var(--cp-muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.arrow { color: var(--cp-muted); font-size: 36rpx; }
.secure-on { color: var(--cp-accent); font-size: 22rpx; font-weight: 650; }
.settings-entry { margin-top: 24rpx; }
