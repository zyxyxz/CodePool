.offline-bar { margin: -28rpx -28rpx 20rpx; padding: 16rpx; background: #fff4dc; color: #7a4d00; text-align: center; font-size: 23rpx; }
.audit-header { padding: 10rpx 6rpx 30rpx; }
.audit-header text,.team-picker text { display: block; }
.eyebrow { color: #15803d; font-size: 20rpx; font-weight: 750; letter-spacing: 3rpx; }
.page-title { margin-top: 10rpx; font-size: 42rpx; font-weight: 750; }
.page-desc { margin-top: 8rpx; color: #718078; font-size: 23rpx; line-height: 1.55; }
.team-picker { padding: 26rpx 28rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 24rpx; background: #101820; color: #fff; }
.team-picker view text:first-child { color: #9eaaa3; font-size: 20rpx; }
.team-picker view text:last-child { margin-top: 5rpx; font-size: 28rpx; font-weight: 650; }
.team-picker > text { color: #7ce79d; font-size: 22rpx; }
.filter-scroll { width: calc(100% + 28rpx); margin: 18rpx 0; white-space: nowrap; }
.filter-row { padding-right: 28rpx; display: inline-flex; gap: 12rpx; }
.filter-chip { min-height: 68rpx; padding: 12rpx 24rpx; border-radius: 999rpx; background: #e8eee9; color: #536058; font-size: 24rpx; }
.filter-chip.active { background: #17231d; color: #fff; }
.timeline { margin-top: 24rpx; }
.timeline-row { display: flex; align-items: stretch; }
.timeline-line { position: relative; width: 38rpx; flex: none; }
.timeline-line::after { content: ""; position: absolute; top: 26rpx; bottom: -26rpx; left: 12rpx; width: 2rpx; background: #d8e4dc; }
.timeline-row:last-child .timeline-line::after { display: none; }
.dot { position: relative; z-index: 1; width: 24rpx; height: 24rpx; margin-top: 26rpx; border: 5rpx solid #d6f0dd; border-radius: 50%; background: #15803d; }
.dot.share { border-color: #fff0c7; background: #a66b00; }
.dot.member { border-color: #dfe8ff; background: #4267a8; }
.dot.auth { border-color: #e6e9e7; background: #66736b; }
.log-card { min-width: 0; flex: 1; margin-bottom: 18rpx; padding: 24rpx; }
.log-top,.actor-row,.log-meta { display: flex; align-items: center; }
.log-top { justify-content: space-between; gap: 20rpx; }
.action { font-size: 28rpx; font-weight: 680; }
.relative { flex: none; color: #89958e; font-size: 21rpx; }
.actor-row { margin-top: 18rpx; gap: 10rpx; color: #526158; font-size: 23rpx; }
.actor-row image { width: 42rpx; height: 42rpx; border-radius: 50%; background: #edf2ef; }
.actor-row text:nth-child(2) { font-weight: 650; }
.actor-row text:last-child { color: #89958e; }
.log-meta { margin-top: 16rpx; flex-wrap: wrap; gap: 12rpx; color: #9aa59e; font-size: 20rpx; word-break: break-all; }
.safe-note { margin-top: 20rpx; }
