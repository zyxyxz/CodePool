<view class="page">
  <view class="offline-bar" wx:if="{{offline}}">当前处于离线状态</view>

  <view class="card state-card" wx:if="{{needsLogin}}">
    <text class="state-symbol">◎</text>
    <text class="state-title">登录后查看安全审计</text>
    <text class="state-desc">审计记录帮助团队追溯敏感内容的创建、查看、修改和分享。</text>
    <button class="button-primary" bindtap="goLogin">前往登录</button>
  </view>

  <block wx:else>
    <view class="audit-header">
      <text class="eyebrow">SECURITY AUDIT</text>
      <text class="page-title">团队安全审计</text>
      <text class="page-desc">用于追溯关键操作；不记录代码池正文或 TOTP 密钥。</text>
    </view>

    <picker wx:if="{{teams.length}}" mode="selector" range="{{teams}}" range-key="name" value="{{teamIndex}}" bindchange="handleTeamChange">
      <view class="team-picker"><view><text>当前团队</text><text>{{currentTeam.name}}</text></view><text>切换 ›</text></view>
    </picker>

    <scroll-view class="filter-scroll" scroll-x enable-flex wx:if="{{teams.length}}">
      <view class="filter-row">
        <block wx:for="{{filters}}" wx:key="value"><button class="filter-chip {{activeFilter === item.value ? 'active' : ''}}" data-filter="{{item.value}}" bindtap="handleFilter">{{item.label}}</button></block>
      </view>
    </scroll-view>

    <view class="card state-card" wx:if="{{loading}}"><text class="state-symbol">···</text><text class="state-title">正在加载审计记录</text><text class="state-desc">仅同步当前权限范围内的操作元数据。</text></view>
    <view class="card state-card" wx:elif="{{error}}"><text class="state-symbol">!</text><text class="state-title">审计日志加载失败</text><text class="state-desc">{{error}}</text><button class="button-secondary" bindtap="handleRetry">重新加载</button></view>
    <view class="card state-card" wx:elif="{{!teams.length}}"><text class="state-symbol">∅</text><text class="state-title">暂无团队</text><text class="state-desc">创建或加入团队后，这里会显示安全操作记录。</text></view>
    <view class="card state-card" wx:elif="{{!visibleLogs.length}}"><text class="state-symbol">✓</text><text class="state-title">暂无此类记录</text><text class="state-desc">当前筛选范围内没有安全事件。之后的查看、编辑和分享会显示在这里。</text></view>

    <view class="timeline" wx:else>
      <block wx:for="{{visibleLogs}}" wx:key="id">
        <view class="timeline-row">
          <view class="timeline-line"><view class="dot {{item.category}}"></view></view>
          <view class="card log-card">
            <view class="log-top"><text class="action">{{item.actionLabel}}</text><text class="relative">{{item.relativeText}}</text></view>
            <view class="actor-row"><image src="{{item.actorAvatar}}" mode="aspectFill" /><text>{{item.actorName}}</text><text>操作 {{item.targetText}}</text></view>
            <view class="log-meta"><text>{{item.createdText}}</text><text wx:if="{{item.targetId}}">对象编号 {{item.targetId}}</text></view>
          </view>
        </view>
      </block>
    </view>

    <view class="safe-note" wx:if="{{visibleLogs.length}}">请将审计记录仅用于团队内部排障与追溯，避免转发成员标识或操作时间。</view>
  </block>
</view>
