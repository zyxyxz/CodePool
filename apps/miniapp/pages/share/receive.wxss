.share-header { padding: 20rpx 8rpx 34rpx; text-align: center; }
.share-header text,.title,.identifier,.locked-content text,.success-banner text,.totp-warning { display: block; }
.brand-mark { width: 90rpx; height: 90rpx; margin: 0 auto 20rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--cp-border); border-radius: 26rpx; background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-accent); font-size: 30rpx; font-weight: 650; }
.eyebrow { color: var(--cp-accent); font-size: 19rpx; font-weight: 650; letter-spacing: 0; }
.page-title { margin-top: 10rpx; font-size: 40rpx; font-weight: 650; }
.page-desc { margin: 10rpx auto 0; max-width: 560rpx; color: var(--cp-muted); font-size: 23rpx; line-height: 1.55; }
.error-card .state-symbol { color: #b42318; }
.home-button { width: 100%; margin-top: 14rpx; }
.preview-card,.result-card { padding: 32rpx; border: 1rpx solid var(--cp-border); border-radius: 30rpx; background: var(--cp-surface); box-shadow: 0 14rpx 40rpx rgba(62,52,42,.05); }
.preview-top,.preview-meta,.result-actions { display: flex; align-items: center; }
.preview-top { justify-content: space-between; gap: 20rpx; }
.kind { padding: 8rpx 14rpx; border-radius: 10rpx; background: var(--cp-tint); color: var(--cp-accent); font-size: 20rpx; font-weight: 650; }
.views { color: var(--cp-muted); font-size: 21rpx; }
.title { margin-top: 26rpx; font-size: 40rpx; font-weight: 650; line-height: 1.35; }
.identifier { margin-top: 10rpx; color: var(--cp-muted); font-size: 24rpx; }
.preview-meta { margin-top: 20rpx; gap: 18rpx; color: var(--cp-muted); font-size: 21rpx; }
.locked-content { min-height: 240rpx; margin-top: 26rpx; padding: 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--cp-border); border-radius: 24rpx; background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-muted); font-size: 25rpx; line-height: 1.7; text-align: center; }
.locked-content text:first-child { color: var(--cp-ink); font-size: 29rpx; font-weight: 650; }
.safe-note { margin-top: 20rpx; }
.claim-button { width: 100%; margin-top: 22rpx; }
.success-banner { margin-bottom: 20rpx; padding: 22rpx 26rpx; border-radius: 22rpx; background: var(--cp-tint); color: var(--cp-accent); }
.success-banner text:first-child { font-size: 28rpx; font-weight: 680; }
.success-banner text:last-child { margin-top: 5rpx; color: var(--cp-muted); font-size: 21rpx; }
.content-box { min-height: 260rpx; margin: 26rpx 0; padding: 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: linear-gradient(135deg, var(--cp-hero-start), var(--cp-hero-end)); color: var(--cp-muted); text-align: center; }
.content-box.visible { align-items: flex-start; justify-content: flex-start; color: var(--cp-ink); text-align: left; }
.content-box text { font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.totp-warning { margin-top: 12rpx; color: #765000; font-size: 22rpx; text-align: center; }
.result-actions { margin-top: 24rpx; gap: 14rpx; }
.result-actions button { flex: 1; }
