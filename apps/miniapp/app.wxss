page {
  min-height: 100%;
  background: #f3f6f4;
  color: #17231d;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1.25;
  transition: opacity 120ms ease, transform 120ms ease;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.78;
  transform: scale(0.985);
}

button[disabled] {
  opacity: 0.52;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border: 1rpx solid #e3ebe6;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 54, 34, 0.045);
  margin-bottom: 20rpx;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.section-title {
  display: block;
  color: #17231d;
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
}

.page-header {
  padding: 6rpx 4rpx 28rpx;
}

.eyebrow {
  display: block;
  color: #16724a;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.page-title {
  display: block;
  margin-top: 10rpx;
  color: #17231d;
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.25;
}

.page-desc {
  display: block;
  margin-top: 10rpx;
  color: #66736b;
  font-size: 24rpx;
  line-height: 1.6;
}

.muted {
  color: #718078;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #edf7f0;
  color: #166534;
  font-size: 22rpx;
}

.button-primary,
.button-secondary,
.button-danger,
.button-ghost {
  min-height: 88rpx;
  border-radius: 14rpx;
  padding: 20rpx 28rpx;
  font-weight: 650;
}

.button-primary {
  color: #ffffff;
  background: #15803d;
}

.button-primary[disabled] {
  color: rgba(255, 255, 255, 0.75);
  background: #78a887;
}

.button-secondary {
  color: #166534;
  background: #edf7f0;
}

.button-ghost {
  color: #405047;
  background: #f3f6f4;
}

.button-danger {
  color: #b42318;
  background: #fff1f0;
}

.button-small {
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #405047;
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #dbe5df;
  border-radius: 14rpx;
  background: #f8faf9;
  color: #17231d;
}

.textarea {
  min-height: 280rpx;
  line-height: 1.6;
}

.input:focus,
.textarea:focus {
  border-color: #23855a;
  background: #ffffff;
}

.state-card {
  padding: 56rpx 36rpx;
  text-align: center;
}

.state-symbol {
  display: block;
  margin-bottom: 20rpx;
  color: #15803d;
  font-size: 56rpx;
  font-weight: 700;
}

.state-title {
  display: block;
  color: #17231d;
  font-size: 32rpx;
  font-weight: 650;
}

.state-desc {
  display: block;
  margin: 14rpx auto 28rpx;
  max-width: 520rpx;
  color: #718078;
  font-size: 25rpx;
  line-height: 1.6;
}

.safe-note {
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #87b99a;
  border-radius: 10rpx;
  background: #edf5ef;
  color: #526158;
  font-size: 23rpx;
  line-height: 1.6;
}
