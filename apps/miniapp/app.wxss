page {
  min-height: 100%;
  --cp-bg: #F5F7F2;
  --cp-surface: #FFFDFA;
  --cp-ink: #273B32;
  --cp-muted: #62655F;
  --cp-accent: #426B5A;
  --cp-tint: #E7EFE5;
  --cp-border: #D9E4D7;
  --cp-hero-start: #E3EDDF;
  --cp-hero-end: #F4EADF;
  background: var(--cp-bg);
  color: var(--cp-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
form,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1.25;
  transition: opacity 120ms ease, transform 120ms ease;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.78;
  transform: scale(0.985);
}

button[disabled] {
  opacity: 0.52;
}

.page {
  min-height: 100vh;
  background: var(--cp-bg);
  color: var(--cp-ink);
  padding: 32rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--cp-surface);
  border: 1rpx solid var(--cp-border);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(55, 46, 37, 0.035);
  margin-bottom: 24rpx;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.section-title {
  display: block;
  color: var(--cp-ink);
  font-size: 30rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
}

.page-header {
  padding: 6rpx 4rpx 28rpx;
}

.eyebrow {
  display: block;
  color: var(--cp-accent);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.page-title {
  display: block;
  margin-top: 10rpx;
  color: var(--cp-ink);
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.25;
}

.page-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--cp-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.muted {
  color: var(--cp-muted);
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--cp-tint);
  color: var(--cp-accent);
  font-size: 22rpx;
}

.button-primary,
.button-secondary,
.button-danger,
.button-ghost {
  min-height: 88rpx;
  border-radius: 22rpx;
  padding: 20rpx 28rpx;
  font-weight: 650;
}

.button-primary {
  color: #ffffff;
  background: var(--cp-accent);
}

.button-primary[disabled] {
  color: rgba(255, 255, 255, 0.75);
  background: var(--cp-accent);
}

.button-secondary {
  color: var(--cp-accent);
  background: var(--cp-tint);
}

.button-ghost {
  color: var(--cp-muted);
  background: var(--cp-bg);
}

.button-danger {
  color: #b42318;
  background: #fff1f0;
}

.button-small {
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--cp-ink);
  font-size: 25rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--cp-border);
  border-radius: 20rpx;
  background: var(--cp-bg);
  color: var(--cp-ink);
}

.textarea {
  min-height: 280rpx;
  line-height: 1.6;
}

.input:focus,
.textarea:focus {
  border-color: var(--cp-accent);
  background: var(--cp-surface);
}

.state-card {
  padding: 56rpx 36rpx;
  text-align: center;
}

.state-symbol {
  display: block;
  margin-bottom: 20rpx;
  color: var(--cp-accent);
  font-size: 56rpx;
  font-weight: 700;
}

.state-title {
  display: block;
  color: var(--cp-ink);
  font-size: 32rpx;
  font-weight: 650;
}

.state-desc {
  display: block;
  margin: 14rpx auto 28rpx;
  max-width: 520rpx;
  color: var(--cp-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.safe-note {
  padding: 20rpx 24rpx;
  border-left: 3rpx solid var(--cp-border);
  border-radius: 18rpx;
  background: var(--cp-tint);
  color: var(--cp-muted);
  font-size: 23rpx;
  line-height: 1.6;
}
