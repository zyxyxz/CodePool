# 生产环境必须替换为至少 32 字节的随机值
CODEPOOL_JWT_SECRET=
CODEPOOL_MASTER_KEY=
CODEPOOL_ADMIN_EMAIL=
CODEPOOL_ADMIN_PASSWORD=
CODEPOOL_OPERATOR_NAME=
CODEPOOL_SUPPORT_EMAIL=

# 相对 apps/web 的 SQLite 路径，也可以使用绝对路径
CODEPOOL_DATABASE_PATH=./data/codepool.db
# Dokploy 单层反向代理为 1；若前面还有可信代理，请填写总跳数
CODEPOOL_TRUSTED_PROXY_HOPS=1

# 微信小程序；未配置时仅允许非生产环境 mock 登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK_LOGIN=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 备份密钥必须与 JWT 和数据主密钥不同；备份目录需另行同步到异机或对象存储
CODEPOOL_BACKUP_KEY=
CODEPOOL_BACKUP_DIR=./backups
