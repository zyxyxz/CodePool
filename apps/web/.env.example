# 生产环境必须替换为至少 32 字节的随机值
CODEPOOL_JWT_SECRET=replace-with-a-long-random-secret
CODEPOOL_MASTER_KEY=replace-with-a-different-long-random-secret
CODEPOOL_ADMIN_EMAIL=admin@example.com
CODEPOOL_ADMIN_PASSWORD=change-me-now

# 相对 apps/web 的 SQLite 路径，也可以使用绝对路径
CODEPOOL_DATABASE_PATH=./data/codepool.db

# 微信小程序；未配置时仅允许非生产环境 mock 登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK_LOGIN=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
