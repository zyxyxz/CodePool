{
  "name": "codepool",
  "version": "0.3.2",
  "private": true,
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm run dev -w @codepool/web",
    "build": "npm run build -w @codepool/web",
    "start": "npm run start -w @codepool/web",
    "lint": "npm run lint -w @codepool/web",
    "typecheck": "npm run typecheck -w @codepool/web",
    "test": "npm run test -w @codepool/web",
    "check": "npm run lint && npm run typecheck && npm run check:miniapp && npm run test && npm run build",
    "check:miniapp": "node scripts/check-miniapp.mjs",
    "smoke:security": "node apps/web/scripts/security-smoke.mjs",
    "db:init": "npm run db:init -w @codepool/web",
    "db:backup": "npm run db:backup -w @codepool/web",
    "db:verify-backup": "npm run db:verify-backup -w @codepool/web",
    "db:restore": "npm run db:restore -w @codepool/web"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
